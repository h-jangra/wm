# ==============================================================================
# Mako Notification Daemon Configuration
# Clean, minimal Wayland notification cards styled with the Nord palette.
# ==============================================================================

# Appearance
font=JetBrainsMono Nerd Font 10
background-color=#2E3440F0
text-color=#D8DEE9
width=340
height=110
margin=14
padding=12
border-size=1
border-color=#88C0D0
border-radius=8

# Layout & Behavior
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0
group-by=summary

# Urgency Specific Styles
[urgency=low]
border-color=#4C566A
default-timeout=3000

[urgency=normal]
border-color=#88C0D0
default-timeout=5000

[urgency=critical]
border-color=#BF616A
text-color=#ECEFF4
default-timeout=0
