# Mako Notification Daemon Configuration - Catppuccin Mocha
# Generated by central theme-engine

# Appearance
font=Maple Mono NF 10
background-color=#181825F2
text-color=#cdd6f4
width=350
height=110
margin=14
padding=12
border-size=1
border-color=#b4befe
border-radius=6

# Layout & Behavior
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0
group-by=summary

# Progress bar styling for OSD (volume, brightness)
progress-color=#b4befeFF

# Urgency Specific Styles
[urgency=low]
border-color=#45475a
default-timeout=3000

[urgency=normal]
border-color=#b4befe
default-timeout=5000

[urgency=critical]
border-color=#f38ba8
text-color=#FFFFFF
default-timeout=0
