{
    // Waybar Configuration - Minimal Noctalia Pill Layout
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 4,
    "margin-left": 6,
    "margin-right": 6,
    "spacing": 4,

    // Minimal Layout: Left (Workspaces), Center (Clock), Right (Memory, Audio, Network, Battery, Tray)
    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "memory",
        "pulseaudio",
        "network",
        "battery",
        "tray"
    ],

    // -------------------------------------------------------------------------
    // Left Modules: Workspaces
    // -------------------------------------------------------------------------
    "ext/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-click-right": "mmsg dispatch switch_layout >/dev/null 2>&1",
        "on-scroll-up": "mmsg dispatch viewtoleft >/dev/null 2>&1",
        "on-scroll-down": "mmsg dispatch viewtoright >/dev/null 2>&1",
        "sort-by-id": true,
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十"
        }
    },

    // -------------------------------------------------------------------------
    // Center Module: Clock
    // -------------------------------------------------------------------------
    "clock": {
        "format": "󰥔 {:%a %I:%M %p}",
        "format-alt": "󰥔 {:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<big>{:%A · %B %d, %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "rofi-calendar"
    },

    // -------------------------------------------------------------------------
    // Right Modules: System Stats & Quick Toggles
    // -------------------------------------------------------------------------
    "memory": {
        "format": "󰍛 {used:0.1f}GB",
        "interval": 10,
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nClick: System Monitor",
        "on-click": "footclient -e btop || foot -e btop"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁 {volume}%",
        "format-bluetooth": "󰋋 {volume}%",
        "format-bluetooth-muted": "󰟎 {volume}%",
        "scroll-step": 5,
        "on-click": "rofi-audio",
        "on-click-right": "volume --toggle",
        "on-click-middle": "volume --toggle-mic",
        "tooltip-format": "Audio: {desc} ({volume}%)\nLeft-click: Device Switcher\nRight-click: Toggle Mute\nMiddle-click: Toggle Mic"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-linked": "󰈁 {ifname}",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength}%)\nIP: {ipaddr}\nGW: {gwaddr}",
        "tooltip-format-ethernet": "Ethernet: {ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Network: Disconnected",
        "on-click": "rofi-wifi"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-full": "󰁹 Full",
        "tooltip-format": "Battery: {capacity}% ({timeTo})\nClick: Power Profiles",
        "on-click": "rofi-power-profile"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 6
    },

    // -------------------------------------------------------------------------
    // Optional Modules (can be re-enabled if desired)
    // -------------------------------------------------------------------------
    "custom/window": {
        "exec": "mango-window-waybar",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "max-length": 30
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "format-disabled": "󰂲",
        "tooltip-format": "Bluetooth: {controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "Bluetooth: {controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "rofi-bluetooth"
    },

    "custom/launcher": {
        "format": "󰣚",
        "tooltip": true,
        "tooltip-format": "Launcher (Super + Space)\nThemes (Super + T)",
        "on-click": "rofi-launcher",
        "on-click-right": "rofi-theme"
    },

    "custom/session": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power & Session Menu (Super + Escape)",
        "on-click": "rofi-powermenu"
    }
}
