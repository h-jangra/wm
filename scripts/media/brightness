#!/usr/bin/env bash
# ==============================================================================
# brightness: Hardware monitor brightness control via brightnessctl
# Rootless control via video group membership with OSD notifications.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
ICON_DIR="${REPO_DIR}/assets/icons"

notify_brightness() {
    local percent="$1"
    local icon="${ICON_DIR}/brightness-100.svg"
    if [[ "$percent" -le 25 ]]; then
        icon="${ICON_DIR}/brightness-20.svg"
    elif [[ "$percent" -le 50 ]]; then
        icon="${ICON_DIR}/brightness-40.svg"
    elif [[ "$percent" -le 75 ]]; then
        icon="${ICON_DIR}/brightness-60.svg"
    fi

    notify-send -h string:x-canonical-private-synchronous:wm-osd-bright \
                -h int:value:"$percent" \
                -i "$icon" \
                "Brightness: ${percent}%"
}

get_brightness() {
    if command -v brightnessctl >/dev/null 2>&1; then
        local max=$(brightnessctl max 2>/dev/null || echo 100)
        local cur=$(brightnessctl get 2>/dev/null || echo 0)
        if [[ "$max" -gt 0 ]]; then
            echo $(( (cur * 100) / max ))
        else
            echo "0"
        fi
    else
        echo "0"
    fi
}

cmd="${1:---get}"

case "$cmd" in
    --inc)
        if command -v brightnessctl >/dev/null 2>&1; then
            brightnessctl set +5% -q || true
            notify_brightness "$(get_brightness)"
        fi
        ;;
    --dec)
        if command -v brightnessctl >/dev/null 2>&1; then
            brightnessctl set 5%- -q || true
            notify_brightness "$(get_brightness)"
        fi
        ;;
    --get)
        get_brightness
        ;;
    *)
        echo "Usage: $0 {--inc|--dec|--get}"
        exit 1
        ;;
esac
