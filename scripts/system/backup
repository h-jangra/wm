#!/usr/bin/env bash
set -e

repo="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
tag="${1:-$(date +%Y%m%d_%H%M%S)}"
target="$repo/backups/backup-$tag"

mkdir -p "$target"

for item in config themes scripts assets wallpapers system packages state install.sh README.md; do
    if [[ -e "$repo/$item" ]]; then
        cp -a "$repo/$item" "$target/"
    fi
done

echo "Backup: $target"
