#!/usr/bin/env bash
# ==============================================================================
# rofi-power-profile: Power Mode Selector for Waybar Battery Module
# Displays Power Save | Balanced | Performance in a 3-column Rofi grid.
# ==============================================================================
set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rofi"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$SCRIPT_DIR/../rofi"
CACHE_FILE="$HOME/.cache/wm-power-profile"

if [[ -f "$CONF_DIR/power-profile.rasi" ]]; then
    RASI="$CONF_DIR/power-profile.rasi"
elif [[ -f "$REPO_DIR/power-profile.rasi" ]]; then
    RASI="$REPO_DIR/power-profile.rasi"
else
    RASI=""
fi

notify() {
    notify-send -h string:x-canonical-private-synchronous:wm-power "Power Profile" "$1"
}

# Detect current mode
current_mode=""
if [[ -f "$CACHE_FILE" ]]; then
    current_mode=$(cat "$CACHE_FILE" | tr -d '[:space:]')
elif command -v powerprofilesctl >/dev/null 2>&1; then
    current_mode=$(powerprofilesctl get 2>/dev/null || echo "")
elif [[ -f /sys/firmware/acpi/platform_profile ]]; then
    current_mode=$(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo "")
fi

# Normalize current mode
case "$current_mode" in
    *power*|*save*)
        norm_mode="powersave"
        ;;
    *perf*)
        norm_mode="performance"
        ;;
    *)
        norm_mode="balanced"
        ;;
esac

# Options
opt_powersave="󰌪  Power Save"
opt_balanced="󰾆  Balanced"
opt_performance="󰓅  Performance"

if [[ "$norm_mode" == "powersave" ]]; then
    opt_powersave="${opt_powersave} ✓"
elif [[ "$norm_mode" == "performance" ]]; then
    opt_performance="${opt_performance} ✓"
else
    opt_balanced="${opt_balanced} ✓"
fi

options="${opt_powersave}\n${opt_balanced}\n${opt_performance}"
chosen=$(printf "%b" "$options" | rofi -dmenu -p "Power Profile" ${RASI:+-theme "$RASI"})

[[ -z "$chosen" ]] && exit 0

set_profile() {
    local target="$1"
    local desc="$2"
    mkdir -p "$(dirname "$CACHE_FILE")"
    echo "$target" > "$CACHE_FILE"

    if command -v powerprofilesctl >/dev/null 2>&1; then
        local pp_target="$target"
        [[ "$target" == "powersave" ]] && pp_target="power-saver"
        powerprofilesctl set "$pp_target" 2>/dev/null || true
    else
        # Try direct kernel sysfs writes, fallback to pkexec if not writable
        local acpi_val="$target"
        [[ "$target" == "balanced" ]] && acpi_val="balanced"
        
        local cmd="
            if [ -w /sys/firmware/acpi/platform_profile ]; then
                echo '$acpi_val' > /sys/firmware/acpi/platform_profile 2>/dev/null || true
            fi
            for e in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
                if [ -w \"\$e\" ]; then
                    case '$target' in
                        powersave) echo 'power' > \"\$e\" 2>/dev/null || true ;;
                        performance) echo 'performance' > \"\$e\" 2>/dev/null || true ;;
                        balanced) echo 'balance_performance' > \"\$e\" 2>/dev/null || true ;;
                    esac
                fi
            done
            for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
                if [ -w \"\$g\" ]; then
                    case '$target' in
                        powersave) echo 'powersave' > \"\$g\" 2>/dev/null || true ;;
                        performance) echo 'performance' > \"\$g\" 2>/dev/null || true ;;
                        balanced) echo 'powersave' > \"\$g\" 2>/dev/null || true ;;
                    esac
                fi
            done
        "
        # Run directly if writable
        if [ -w /sys/firmware/acpi/platform_profile 2>/dev/null ]; then
            bash -c "$cmd" 2>/dev/null || true
        elif command -v pkexec >/dev/null 2>&1; then
            pkexec bash -c "$cmd" 2>/dev/null || true
        fi
    fi

    notify "Mode activated: ${desc}"
}

if [[ "$chosen" == *"Power Save"* ]]; then
    set_profile "powersave" "Power Save"
elif [[ "$chosen" == *"Balanced"* ]]; then
    set_profile "balanced" "Balanced"
elif [[ "$chosen" == *"Performance"* ]]; then
    set_profile "performance" "Performance"
fi
