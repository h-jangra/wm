#!/usr/bin/env python3
"""
theme-from-wallpaper: Generate and apply dynamic theme from wallpaper via pywal16.
Workflow:
wallpaper -> pywal16 -> ~/wm/themes/dynamic.json -> theme-engine -> entire desktop.
Leaves static themes untouched.
"""
import sys
import os
import json
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
SCRIPTS_DIR = os.path.dirname(SCRIPT_DIR)
REPO_DIR = os.path.dirname(SCRIPTS_DIR)
THEMES_DIR = os.path.join(REPO_DIR, "themes")
GENERATED_DIR = os.path.join(THEMES_DIR, "generated")
CACHE_DIR = os.path.expanduser("~/.cache")
VENV_WAL = os.path.expanduser("~/.local/share/wm/venv/bin/wal")

def get_target_wallpaper():
    if len(sys.argv) > 1 and sys.argv[1]:
        cand = os.path.realpath(sys.argv[1])
        if os.path.isfile(cand):
            return cand

    cache_file = os.path.join(CACHE_DIR, "current_wallpaper")
    if os.path.isfile(cache_file):
        with open(cache_file, "r") as f:
            cand = f.read().strip()
            if os.path.isfile(cand):
                return cand

    default_wp = os.path.join(REPO_DIR, "wallpapers", "nord.jpg")
    if os.path.isfile(default_wp):
        return default_wp

    first_wp = None
    wp_dir = os.path.join(REPO_DIR, "wallpapers")
    for root, _, files in os.walk(wp_dir):
        for f in files:
            if f.lower().endswith((".jpg", ".jpeg", ".png", ".webp")):
                return os.path.join(root, f)

    return None

def main():
    target = get_target_wallpaper()
    if not target or not os.path.isfile(target):
        print("Error: No valid wallpaper image found.", file=sys.stderr)
        sys.exit(1)

    print(f"Extracting colors from: {target}...")

    # Run wal with colorthief backend in user venv
    if os.path.isfile(VENV_WAL) and os.access(VENV_WAL, os.X_OK):
        wal_cmd = [VENV_WAL, "-i", target, "-n", "--backend", "colorthief", "-s", "-t", "-e", "-q"]
    else:
        wal_cmd = ["wal", "-i", target, "-n", "-s", "-t", "-e", "-q"]

    res = subprocess.run(wal_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if res.returncode != 0:
        print(f"Warning: wal exited with code {res.returncode}: {res.stderr}", file=sys.stderr)

    wal_colors_file = os.path.join(CACHE_DIR, "wal", "colors.json")
    if not os.path.isfile(wal_colors_file):
        print("Error: wal failed to generate colors.json", file=sys.stderr)
        sys.exit(1)

    with open(wal_colors_file, "r") as f:
        wal_data = json.load(f)

    special = wal_data.get("special", {})
    colors = wal_data.get("colors", {})

    bg = special.get("background", "#1e1e2e")
    fg = special.get("foreground", "#cdd6f4")
    cursor = special.get("cursor", fg)

    c0 = colors.get("color0", bg)
    c1 = colors.get("color1", "#e06c75")
    c2 = colors.get("color2", "#98c379")
    c3 = colors.get("color3", "#e5c07b")
    c4 = colors.get("color4", "#61afef")
    c5 = colors.get("color5", "#c678dd")
    c6 = colors.get("color6", "#56b6c2")
    c7 = colors.get("color7", fg)
    c8 = colors.get("color8", "#5c6370")
    c9 = colors.get("color9", c1)
    c10 = colors.get("color10", c2)
    c11 = colors.get("color11", c3)
    c12 = colors.get("color12", c4)
    c13 = colors.get("color13", c5)
    c14 = colors.get("color14", c6)
    c15 = colors.get("color15", "#ffffff")

    # Capsule background: clean dark surface
    capsule_bg = c0
    capsule_hover = c8
    capsule_fg = fg
    accent = c4
    accent_alt = c5

    dynamic_palette = {
        "name": "Dynamic Wallpaper",
        "id": "dynamic",
        "background": bg,
        "foreground": fg,
        "accent": accent,
        "accent_alt": accent_alt,
        "cursor": cursor,
        "capsule_bg": capsule_bg,
        "capsule_hover": capsule_hover,
        "capsule_fg": capsule_fg,
        "border": c8,
        "selection_bg": c8,
        "selection_fg": c15,
        "clock": c5,
        "ram": c4,
        "keyviz": c6,
        "recorder": c1,
        "ws_focused": accent,
        "ws_occupied": c5,
        "ws_empty": c8,
        "ws_urgent": c1,
        "bt": c6,
        "net": c3,
        "vol": c2,
        "bat": c6,
        "session": c1,
        "color0": c0,
        "color1": c1,
        "color2": c2,
        "color3": c3,
        "color4": c4,
        "color5": c5,
        "color6": c6,
        "color7": c7,
        "color8": c8,
        "color9": c9,
        "color10": c10,
        "color11": c11,
        "color12": c12,
        "color13": c13,
        "color14": c14,
        "color15": c15,
        "wallpaper": target
    }

    # Save to dynamic.json without touching static themes
    dyn_path = os.path.join(THEMES_DIR, "dynamic.json")
    with open(dyn_path, "w") as f:
        json.dump(dynamic_palette, f, indent=2)

    # Apply the dynamic theme
    engine_cmd = [sys.executable, os.path.join(SCRIPT_DIR, "theme-engine.py"), "dynamic", "--no-wallpaper"]
    subprocess.run(engine_cmd, check=True)

    print(f"Dynamic theme derived from {os.path.basename(target)} applied successfully!")

if __name__ == "__main__":
    main()
