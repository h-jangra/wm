#!/usr/bin/env bash
# ==============================================================================
# backup: Save a clean snapshot of the desktop rice configuration
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
BACKUP_ROOT="${REPO_DIR}/backups"

tag="${1:-$(date +%Y%m%d_%H%M%S)}"
target_dir="${BACKUP_ROOT}/backup-${tag}"

mkdir -p "$target_dir"

echo "Creating desktop rice backup in: ${target_dir}..."

# Core dotfiles in ~/wm
for dir in mango mangobar waybar rofi mako thunar terminal gtk-3.0 themes scripts; do
    if [[ -d "${REPO_DIR}/${dir}" ]]; then
        cp -a "${REPO_DIR}/${dir}" "${target_dir}/"
    fi
done

# User level configs
if [[ -d "$HOME/.config/xfce4" ]]; then
    cp -a "$HOME/.config/xfce4" "${target_dir}/"
fi
if [[ -d "$HOME/.config/btop" ]]; then
    cp -a "$HOME/.config/btop" "${target_dir}/"
fi

notify-send -h string:x-canonical-private-synchronous:wm-backup "Rice Backup" "Snapshot saved: backup-${tag}"
echo "Backup complete: ${target_dir}"
