#!/usr/bin/env bash
# ==============================================================================
# mango-window-waybar: Real-time focused window title for Waybar
# High-performance, pure Shell + jq implementation (zero Python runtime overhead)
# Automatically terminates on broken pipe, signal, or parent exit.
# ==============================================================================
set -euo pipefail

trap 'exit 0' SIGINT SIGTERM SIGHUP SIGPIPE EXIT

JQ_FILTER='
  def trunc(n): if length > n then .[0:(n-3)] + "..." else . end;
  (if (.title // "") != "" then .title elif (.appid // "") != "" then .appid else "" end) as $t |
  if $t == "" then
    {"text": "", "class": "window-empty"}
  else
    {"text": ($t | trunc(35)), "tooltip": (if (.appid // "") != "" and (.title // "") != "" then "\(.appid): \(.title)" else $t end), "class": "window"}
  end
'

# 1. Output initial window state
mmsg get focusing-client 2>/dev/null | jq --unbuffered -c "$JQ_FILTER" 2>/dev/null || true

# 2. Watch stream via persistent IPC (exec replaces shell, jq dies immediately on Waybar pipe closure)
exec mmsg watch focusing-client 2>/dev/null | jq --unbuffered -c "$JQ_FILTER"
