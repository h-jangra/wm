#!/usr/bin/env python3
"""
mango-tags-waybar: Real-time MangoWC workspace status for Waybar.
Renders workspaces as compact pills styled after the Noctalia visual reference:
- Active pill: wider bar (2.5x) in focused accent
- Occupied pill: standard bar (1.0x) in occupied accent
- Empty workspace: subtle dot in empty accent
- Urgent workspace: accented alert pill
Dynamically reads color tokens from themes/palette.json or fallback.
"""
import sys
import os
import json
import subprocess
import time
import signal

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
PALETTE_FILE = os.path.join(SCRIPT_DIR, "../themes/palette.json")
CACHE_PALETTE = os.path.expanduser("~/.cache/wm-palette.json")

# Default Noctalia workspace color fallback
DEFAULT_COLORS = {
    "ws_focused": "#B4BEFE",
    "ws_occupied": "#B090D7",
    "ws_empty": "#89DCEB",
    "ws_urgent": "#D894A1"
}

cached_mtime = 0
current_colors = DEFAULT_COLORS.copy()

def load_palette():
    global cached_mtime, current_colors
    target = None
    if os.path.isfile(PALETTE_FILE):
        target = PALETTE_FILE
    elif os.path.isfile(CACHE_PALETTE):
        target = CACHE_PALETTE

    if target:
        try:
            mtime = os.path.getmtime(target)
            if mtime != cached_mtime:
                cached_mtime = mtime
                with open(target, "r") as f:
                    data = json.load(f)
                    current_colors["ws_focused"] = data.get("ws_focused", DEFAULT_COLORS["ws_focused"])
                    current_colors["ws_occupied"] = data.get("ws_occupied", DEFAULT_COLORS["ws_occupied"])
                    current_colors["ws_empty"] = data.get("ws_empty", DEFAULT_COLORS["ws_empty"])
                    current_colors["ws_urgent"] = data.get("ws_urgent", DEFAULT_COLORS["ws_urgent"])
        except Exception:
            pass

def sig_handler(signum, frame):
    sys.exit(0)

signal.signal(signal.SIGTERM, sig_handler)
signal.signal(signal.SIGINT, sig_handler)

def format_tags(data):
    load_palette()
    try:
        monitors = data.get("all_tags", [])
        if not monitors:
            return {"text": "━━ ━ ● ● ●", "class": "workspaces"}

        tags = monitors[0].get("tags", [])
        parts = []
        tooltip_lines = []

        focused_col = current_colors["ws_focused"]
        occupied_col = current_colors["ws_occupied"]
        empty_col = current_colors["ws_empty"]
        urgent_col = current_colors["ws_urgent"]

        for t in tags:
            idx = t.get("index", 1)
            active = t.get("is_active", False)
            count = t.get("client_count", 0)
            urgent = t.get("is_urgent", False)

            if urgent:
                parts.append(f'<span color="{urgent_col}" weight="bold">━━</span>')
                tooltip_lines.append(f"Workspace {idx}: Urgent")
            elif active:
                # Active pill: 2.5x size
                parts.append(f'<span color="{focused_col}" weight="bold">━━</span>')
                tooltip_lines.append(f"Workspace {idx}: Active ({count} window{'s' if count != 1 else ''})")
            elif count > 0:
                # Occupied pill: 1.0x size
                parts.append(f'<span color="{occupied_col}">━</span>')
                tooltip_lines.append(f"Workspace {idx}: {count} window{'s' if count != 1 else ''}")
            else:
                # Empty workspace: subtle dot
                parts.append(f'<span color="{empty_col}">●</span>')

        return {
            "text": " ".join(parts),
            "tooltip": "\n".join(tooltip_lines) if tooltip_lines else "MangoWC Workspaces",
            "class": "workspaces"
        }
    except Exception:
        return {"text": "━━ ━ ● ● ●", "class": "workspaces"}

def main():
    while True:
        try:
            init_proc = subprocess.run(["mmsg", "get", "all-tags"], stdout=subprocess.PIPE, text=True, timeout=2)
            if init_proc.returncode == 0 and init_proc.stdout.strip():
                try:
                    init_data = json.loads(init_proc.stdout)
                    print(json.dumps(format_tags(init_data)), flush=True)
                except Exception:
                    pass

            proc = subprocess.Popen(["mmsg", "watch", "all-tags"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            for line in proc.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    data = json.loads(line)
                    print(json.dumps(format_tags(data)), flush=True)
                except Exception:
                    continue

            proc.wait()
        except FileNotFoundError:
            print(json.dumps({"text": "━━ ━ ● ● ●", "class": "workspaces"}), flush=True)
            time.sleep(5)
        except Exception:
            pass

        time.sleep(2)

if __name__ == "__main__":
    main()
