#!/usr/bin/env python3
"""
mango-tags-waybar: Real-time MangoWC workspace status for Waybar.
Renders workspaces with Japanese numerals (一, 二, 三, ...).
Hides empty inactive workspaces.
Right-click on Waybar module toggles tiling layout.
Dynamically reads color tokens from themes/palette.json or fallback.
"""
import sys
import os
import json
import subprocess
import time
import signal

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
PALETTE_FILE = os.path.join(SCRIPT_DIR, "../themes/palette.json")
CACHE_PALETTE = os.path.expanduser("~/.cache/wm-palette.json")

# Default Noctalia workspace color fallback
DEFAULT_COLORS = {
    "ws_focused": "#B4BEFE",
    "ws_occupied": "#B090D7",
    "ws_empty": "#89DCEB",
    "ws_urgent": "#D894A1"
}

cached_mtime = 0
current_colors = DEFAULT_COLORS.copy()

KANJI_NUMS = {
    1: "一",
    2: "二",
    3: "三",
    4: "四",
    5: "五",
    6: "六",
    7: "七",
    8: "八",
    9: "九",
    10: "十"
}

def to_kanji(idx):
    if idx in KANJI_NUMS:
        return KANJI_NUMS[idx]
    if 11 <= idx <= 19:
        return "十" + KANJI_NUMS.get(idx - 10, str(idx - 10))
    tens, rem = divmod(idx, 10)
    if rem == 0:
        return KANJI_NUMS.get(tens, str(tens)) + "十"
    return KANJI_NUMS.get(tens, str(tens)) + "十" + KANJI_NUMS.get(rem, str(rem))

def load_palette():
    global cached_mtime, current_colors
    target = None
    if os.path.isfile(PALETTE_FILE):
        target = PALETTE_FILE
    elif os.path.isfile(CACHE_PALETTE):
        target = CACHE_PALETTE

    if target:
        try:
            mtime = os.path.getmtime(target)
            if mtime != cached_mtime:
                cached_mtime = mtime
                with open(target, "r") as f:
                    data = json.load(f)
                    current_colors["ws_focused"] = data.get("ws_focused", DEFAULT_COLORS["ws_focused"])
                    current_colors["ws_occupied"] = data.get("ws_occupied", DEFAULT_COLORS["ws_occupied"])
                    current_colors["ws_empty"] = data.get("ws_empty", DEFAULT_COLORS["ws_empty"])
                    current_colors["ws_urgent"] = data.get("ws_urgent", DEFAULT_COLORS["ws_urgent"])
        except Exception:
            pass

def sig_handler(signum, frame):
    sys.exit(0)

signal.signal(signal.SIGTERM, sig_handler)
signal.signal(signal.SIGINT, sig_handler)

def format_tags(data):
    load_palette()
    try:
        monitors = data.get("all_tags", [])
        if not monitors:
            return {"text": to_kanji(1), "class": "workspaces"}

        target_mon = None
        for m in monitors:
            if m.get("active", False):
                target_mon = m
                break
        if not target_mon and monitors:
            target_mon = monitors[0]

        tags = target_mon.get("tags", []) if target_mon else []
        parts = []
        tooltip_lines = []

        focused_col = current_colors["ws_focused"]
        occupied_col = current_colors["ws_occupied"]
        urgent_col = current_colors["ws_urgent"]

        for t in tags:
            idx = t.get("index", 1)
            active = t.get("is_active", False)
            count = t.get("client_count", 0)
            urgent = t.get("is_urgent", False)
            kanji = to_kanji(idx)

            # Hide empty workspaces (keep active, occupied, or urgent)
            if not active and count == 0 and not urgent:
                continue

            if urgent:
                parts.append(f'<span color="{urgent_col}" weight="bold">{kanji}</span>')
                tooltip_lines.append(f"Workspace {kanji} ({idx}): Urgent")
            elif active:
                parts.append(f'<span color="{focused_col}" weight="bold">{kanji}</span>')
                tooltip_lines.append(f"Workspace {kanji} ({idx}): Active ({count} window{'s' if count != 1 else ''})")
            elif count > 0:
                parts.append(f'<span color="{occupied_col}">{kanji}</span>')
                tooltip_lines.append(f"Workspace {kanji} ({idx}): {count} window{'s' if count != 1 else ''}")

        if not parts:
            parts.append(f'<span color="{focused_col}" weight="bold">{to_kanji(1)}</span>')

        tooltip_lines.append("Right-click: Toggle layout")

        return {
            "text": "  ".join(parts),
            "tooltip": "\n".join(tooltip_lines) if tooltip_lines else "MangoWC Workspaces",
            "class": "workspaces"
        }
    except Exception:
        return {"text": to_kanji(1), "class": "workspaces"}

def main():
    while True:
        try:
            init_proc = subprocess.run(["mmsg", "get", "all-tags"], stdout=subprocess.PIPE, text=True, timeout=2)
            if init_proc.returncode == 0 and init_proc.stdout.strip():
                try:
                    init_data = json.loads(init_proc.stdout)
                    print(json.dumps(format_tags(init_data)), flush=True)
                except Exception:
                    pass

            proc = subprocess.Popen(["mmsg", "watch", "all-tags"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            try:
                for line in proc.stdout:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        data = json.loads(line)
                        print(json.dumps(format_tags(data)), flush=True)
                    except BrokenPipeError:
                        proc.terminate()
                        sys.exit(0)
                    except Exception:
                        continue
            finally:
                try:
                    proc.terminate()
                except Exception:
                    pass

            proc.wait()
        except (BrokenPipeError, KeyboardInterrupt):
            sys.exit(0)
        except FileNotFoundError:
            print(json.dumps({"text": to_kanji(1), "class": "workspaces"}), flush=True)
            time.sleep(5)
        except Exception:
            pass

        time.sleep(2)

if __name__ == "__main__":
    main()
