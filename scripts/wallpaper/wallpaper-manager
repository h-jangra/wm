#!/usr/bin/env bash
# ==============================================================================
# wallpaper-manager: Lightweight Wayland wallpaper daemon manager using swaybg
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
WALLPAPER_DIR="${REPO_DIR}/wallpapers"
USER_WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
CACHE_FILE="${CACHE_DIR}/current_wallpaper"
STATE_DIR="${REPO_DIR}/state"
MODE_FILE="${STATE_DIR}/current_mode"

notify() {
    notify-send -h string:x-canonical-private-synchronous:wm-wall "Wallpaper" "$1"
}

cmd="${1:-restore}"

case "$cmd" in
    set)
        target="${2:-}"
        skip_theme="${3:-}"

        if [[ -z "$target" || ! -f "$target" ]]; then
            echo "Error: Wallpaper file not found: '$target'" >&2
            exit 1
        fi

        # Get absolute canonical path
        target=$(readlink -f "$target")

        # Fallback render target for swaybg (convert webp if needed since swaybg uses gdk-pixbuf)
        render_target="$target"
        if [[ "$target" == *.webp ]]; then
            mkdir -p "$CACHE_DIR"
            converted="$CACHE_DIR/current_rendered_wallpaper.jpg"
            if command -v ffmpeg >/dev/null 2>&1; then
                if ffmpeg -y -v error -i "$target" -q:v 2 -update 1 "$converted" 2>/dev/null; then
                    render_target="$converted"
                fi
            fi
        fi

        # 1. Launch new swaybg instance
        if command -v swaybg >/dev/null 2>&1; then
            swaybg -i "$render_target" -m fill >/dev/null 2>&1 &
            new_pid=$!
            disown "$new_pid" 2>/dev/null || true
            sleep 0.2

            # Kill previous swaybg instances
            for pid in $(pgrep -x swaybg || true); do
                if [[ "$pid" -ne "$new_pid" ]]; then
                    kill "$pid" >/dev/null 2>&1 || true
                fi
            done
        else
            notify "Warning: swaybg is not installed."
        fi

        mkdir -p "$CACHE_DIR"
        echo "$target" > "$CACHE_FILE"

        # 2. If in dynamic theme mode and not skipping, trigger theme regeneration
        current_mode="static"
        [[ -f "$MODE_FILE" ]] && current_mode=$(cat "$MODE_FILE" | tr -d '[:space:]')

        if [[ "$current_mode" == "dynamic" && "$skip_theme" != "--skip-theme" ]]; then
            theme_from_wall="$REPO_DIR/scripts/theme/theme-from-wallpaper"
            [[ -x "$theme_from_wall" ]] || theme_from_wall="$REPO_DIR/scripts/theme-from-wallpaper"
            if [[ -x "$theme_from_wall" ]]; then
                "$theme_from_wall" "$target" >/dev/null 2>&1 || true
            fi
        fi

        notify "Wallpaper updated: $(basename "$target")"
        ;;

    restore)
        if [[ -f "$CACHE_FILE" ]]; then
            cached=$(cat "$CACHE_FILE")
            if [[ -f "$cached" ]]; then
                exec "$0" set "$cached" --skip-theme
            fi
        fi

        # Check theme symlink directory
        if [[ -d "$WALLPAPER_DIR/theme" ]]; then
            first_theme_wall=$(find -L "$WALLPAPER_DIR/theme" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) | head -n1 || true)
            if [[ -n "$first_theme_wall" ]]; then
                exec "$0" set "$first_theme_wall" --skip-theme
            fi
        fi

        # Default fallback
        if [[ -f "$WALLPAPER_DIR/nord.jpg" ]]; then
            exec "$0" set "$WALLPAPER_DIR/nord.jpg" --skip-theme
        elif [[ -d "$WALLPAPER_DIR" ]]; then
            first_found=$(find "$WALLPAPER_DIR" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) | head -n1 || true)
            if [[ -n "$first_found" ]]; then
                exec "$0" set "$first_found" --skip-theme
            fi
        fi
        ;;

    random)
        category="${2:-}"
        search_dirs=()
        if [[ -n "$category" && -d "$WALLPAPER_DIR/$category" ]]; then
            search_dirs+=("$WALLPAPER_DIR/$category")
        else
            search_dirs+=("$WALLPAPER_DIR")
            if [[ -d "$USER_WALLPAPER_DIR" ]]; then
                search_dirs+=("$USER_WALLPAPER_DIR")
            fi
        fi

        random_file=$(find "${search_dirs[@]}" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | shuf -n1 || true)
        if [[ -n "$random_file" ]]; then
            exec "$0" set "$random_file"
        else
            notify "No wallpapers found in ${WALLPAPER_DIR}"
        fi
        ;;

    *)
        echo "Usage: $0 {set <path> [--skip-theme]|restore|random [category]}"
        exit 1
        ;;
esac
