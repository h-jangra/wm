#!/usr/bin/env python3
"""
generate-palette: Generates dynamic theme tokens from current wallpaper.
Produces palette.css, palette.json, palette.env, and palette.rasi.
Falls back to Noctalia reference palette if wallpaper cannot be sampled.
"""
import sys
import os
import json
import colorsys

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
REPO_DIR = os.path.dirname(SCRIPT_DIR)
THEMES_DIR = os.path.join(REPO_DIR, "themes")
CACHE_DIR = os.path.expanduser("~/.cache")

DEFAULT_PALETTE = {
    "capsule_bg": "#242436",
    "capsule_hover": "#2d2d44",
    "capsule_fg": "#D8DEE9",
    "border_color": "#3B4252",
    "clock_color": "#F5C2E7",
    "ram_color": "#CBA6F7",
    "keyviz_color": "#89DCEB",
    "recorder_color": "#D894A1",
    "ws_empty": "#89DCEB",
    "ws_focused": "#B4BEFE",
    "ws_occupied": "#B090D7",
    "ws_urgent": "#D894A1",
    "bt_color": "#B192DA",
    "net_color": "#F9E2AF",
    "vol_color": "#EBA0AC",
    "bat_color": "#79BFCE",
    "session_color": "#F38BA7",
    "accent": "#B4BEFE"
}

def to_hex(h, s, v):
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, max(0.0, min(1.0, s)), max(0.0, min(1.0, v)))
    return f"#{int(r * 255):02x}{int(g * 255):02x}{int(b * 255):02x}"

def extract_palette(image_path):
    if not image_path or not os.path.isfile(image_path):
        return DEFAULT_PALETTE.copy()

    try:
        from PIL import Image
        img = Image.open(image_path).convert("RGB").resize((120, 120))
        q = img.quantize(colors=16, method=Image.Quantize.MEDIANCUT)
        palette_bytes = q.getpalette()[:48]
        rgb_colors = [tuple(palette_bytes[i:i+3]) for i in range(0, len(palette_bytes), 3)]

        hsv_list = [colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0) for r, g, b in rgb_colors]
        # Filter saturated, non-extreme luminance colors
        valid_hsv = [c for c in hsv_list if c[1] > 0.08 and 0.15 < c[2] < 0.85]

        if valid_hsv:
            dom_h = sum(c[0] for c in valid_hsv) / len(valid_hsv)
        else:
            dom_h = 240.0 / 360.0

        # Harmonious tinted capsule palette matching Noctalia visual hierarchy
        capsule_bg = to_hex(dom_h, 0.18, 0.16)
        capsule_hover = to_hex(dom_h, 0.18, 0.24)
        border_color = to_hex(dom_h, 0.15, 0.30)
        capsule_fg = "#D8DEE9"

        return {
            "capsule_bg": capsule_bg,
            "capsule_hover": capsule_hover,
            "capsule_fg": capsule_fg,
            "border_color": border_color,
            "clock_color": to_hex(dom_h + 0.25, 0.30, 0.95),
            "ram_color": to_hex(dom_h + 0.15, 0.32, 0.94),
            "keyviz_color": to_hex(dom_h - 0.15, 0.36, 0.92),
            "recorder_color": to_hex(dom_h + 0.45, 0.38, 0.88),
            "ws_focused": to_hex(dom_h, 0.35, 0.96),
            "ws_occupied": to_hex(dom_h + 0.10, 0.30, 0.86),
            "ws_empty": to_hex(dom_h - 0.10, 0.32, 0.90),
            "ws_urgent": "#D894A1",
            "bt_color": to_hex(dom_h + 0.12, 0.32, 0.92),
            "net_color": to_hex(dom_h - 0.30, 0.38, 0.96),
            "vol_color": to_hex(dom_h + 0.35, 0.35, 0.92),
            "bat_color": to_hex(dom_h - 0.20, 0.38, 0.88),
            "session_color": to_hex(dom_h + 0.40, 0.42, 0.95),
            "accent": to_hex(dom_h, 0.38, 0.95)
        }
    except Exception:
        return DEFAULT_PALETTE.copy()

def write_outputs(palette):
    os.makedirs(THEMES_DIR, exist_ok=True)
    os.makedirs(CACHE_DIR, exist_ok=True)

    # 1. CSS for Waybar
    css_lines = ["/* Dynamic Wallpaper Theme Tokens */"]
    for key, val in palette.items():
        css_lines.append(f"@define-color {key} {val};")
    css_content = "\n".join(css_lines) + "\n"

    with open(os.path.join(THEMES_DIR, "palette.css"), "w") as f:
        f.write(css_content)
    with open(os.path.join(CACHE_DIR, "wm-palette.css"), "w") as f:
        f.write(css_content)

    # 2. JSON for Waybar Scripts (mango-tags-waybar)
    json_content = json.dumps(palette, indent=2) + "\n"
    with open(os.path.join(THEMES_DIR, "palette.json"), "w") as f:
        f.write(json_content)
    with open(os.path.join(CACHE_DIR, "wm-palette.json"), "w") as f:
        f.write(json_content)

    # 3. Shell Environment Tokens
    env_lines = ["# Dynamic Wallpaper Environment Tokens"]
    for key, val in palette.items():
        env_lines.append(f"export WM_{key.upper()}='{val}'")
    env_content = "\n".join(env_lines) + "\n"
    with open(os.path.join(THEMES_DIR, "palette.env"), "w") as f:
        f.write(env_content)

    # 4. Rofi Palette
    rasi_lines = [
        "/**",
        " * Dynamic Wallpaper Theme Tokens for Rofi",
        " **/",
        "* {"
    ]
    for key, val in palette.items():
        rasi_lines.append(f"    {key.replace('_', '-')}: {val}FF;")
    rasi_lines.append("}\n")
    with open(os.path.join(THEMES_DIR, "palette.rasi"), "w") as f:
        f.write("\n".join(rasi_lines))

def main():
    target_wallpaper = None
    if len(sys.argv) > 1 and sys.argv[1]:
        target_wallpaper = sys.argv[1]
    else:
        cache_wp = os.path.join(CACHE_DIR, "current_wallpaper")
        if os.path.isfile(cache_wp):
            with open(cache_wp, "r") as f:
                target_wallpaper = f.read().strip()
        if not target_wallpaper or not os.path.isfile(target_wallpaper):
            target_wallpaper = os.path.join(REPO_DIR, "wallpapers", "nord.jpg")

    palette = extract_palette(target_wallpaper)
    write_outputs(palette)
    print(f"Generated dynamic palette for: {target_wallpaper} (Capsule BG: {palette['capsule_bg']}, Focused: {palette['ws_focused']})")

if __name__ == "__main__":
    main()
