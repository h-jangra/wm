#!/usr/bin/env bash
# ==============================================================================
# start-mango: Wayland Session Launcher for MangoWC on Void Linux
# Sets required environment variables and boots MangoWC cleanly.
# ==============================================================================
set -euo pipefail

# Prepend desktop scripts to PATH
export PATH="$HOME/wm/scripts:$HOME/.config/wm/scripts:$PATH"

# Session & Desktop Specifications
export XDG_CURRENT_DESKTOP=mango
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=mango

# Toolkit Wayland Backend Enforcements
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND="wayland,x11,*"
export CLUTTER_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
export NO_AT_BRIDGE=1

# Ensure XDG Runtime Directory exists
if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    if [[ ! -d "$XDG_RUNTIME_DIR" ]]; then
        mkdir -p "$XDG_RUNTIME_DIR"
        chmod 0700 "$XDG_RUNTIME_DIR"
    fi
fi

# Configuration Path
CONFIG_FILE="$HOME/.config/mango/config.conf"
if [[ ! -f "$CONFIG_FILE" ]]; then
    CONFIG_FILE="$HOME/wm/mango/config.conf"
fi

# Launch within DBus session if not already in one
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session mango -c "$CONFIG_FILE" "$@"
else
    exec mango -c "$CONFIG_FILE" "$@"
fi
