#!/usr/bin/env bash
# ==============================================================================
# theme-switch: Central theme switcher for Void Linux + MangoWC rice
# Usage: theme-switch <theme-id> [--no-wallpaper]
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
THEMES_DIR="${SCRIPT_DIR}/../themes"
DEFS_DIR="${THEMES_DIR}/defs"

show_help() {
    echo "Usage: $(basename "$0") <theme-id> [--no-wallpaper]"
    echo ""
    echo "Available Static Themes:"
    if [[ -d "$DEFS_DIR" ]]; then
        for f in "$DEFS_DIR"/*.json; do
            [[ -f "$f" ]] || continue
            id=$(basename "$f" .json)
            name=$(grep -m1 '"name":' "$f" | awk -F'"' '{print $4}')
            printf "  %-18s (%s)\n" "$id" "$name"
        done
    fi
    echo "  dynamic            (Derived from current wallpaper)"
    echo ""
    echo "Options:"
    echo "  --no-wallpaper     Do not change the active wallpaper"
    echo "  -h, --help         Show this help message"
}

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

theme_id="$1"
shift

# Validate theme exists
if [[ "$theme_id" != "dynamic" && ! -f "$DEFS_DIR/${theme_id}.json" ]]; then
    echo "Error: Unknown theme '${theme_id}'." >&2
    echo "Run '$(basename "$0") --help' to view available themes." >&2
    exit 1
fi

python3 "${SCRIPT_DIR}/theme-engine.py" "$theme_id" "$@"
