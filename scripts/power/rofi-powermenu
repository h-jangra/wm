#!/usr/bin/env bash
# ==============================================================================
# rofi-powermenu: Void-compatible power management menu
# Uses elogind / loginctl where available, with native zzz / sudo fallbacks.
# ==============================================================================
set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rofi"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
ROFI_DIR="${REPO_DIR}/config/rofi"

if [[ -f "$CONF_DIR/power.rasi" ]]; then
    RASI="$CONF_DIR/power.rasi"
elif [[ -f "$ROFI_DIR/power.rasi" ]]; then
    RASI="$ROFI_DIR/power.rasi"
else
    RASI=""
fi

# Menu Options
opt_lock="󰌾  Lock"
opt_logout="󰍃  Logout"
opt_suspend="󰤄  Suspend"
opt_reboot="󰜉  Reboot"
opt_shutdown="󰐥  Shutdown"

chosen=$(printf "%s\n%s\n%s\n%s\n%s\n" \
    "$opt_lock" \
    "$opt_logout" \
    "$opt_suspend" \
    "$opt_reboot" \
    "$opt_shutdown" | rofi -dmenu -p "Power" ${RASI:+-theme "$RASI"})

case "$chosen" in
    "$opt_lock")
        if command -v swaylock >/dev/null 2>&1; then
            swaylock -f -c 2E3440
        else
            notify-send "Lock screen" "swaylock is not installed"
        fi
        ;;
    "$opt_logout")
        if command -v mmsg >/dev/null 2>&1; then
            mmsg dispatch quit || pkill -TERM mango
        else
            pkill -TERM mango || true
        fi
        ;;
    "$opt_suspend")
        if command -v loginctl >/dev/null 2>&1; then
            loginctl suspend || zzz || true
        elif command -v zzz >/dev/null 2>&1; then
            zzz || true
        else
            notify-send "Power" "Unable to suspend: neither loginctl nor zzz found"
        fi
        ;;
    "$opt_reboot")
        if command -v loginctl >/dev/null 2>&1; then
            loginctl reboot || sudo reboot || true
        elif command -v reboot >/dev/null 2>&1; then
            sudo reboot || reboot || true
        fi
        ;;
    "$opt_shutdown")
        if command -v loginctl >/dev/null 2>&1; then
            loginctl poweroff || sudo poweroff || true
        elif command -v poweroff >/dev/null 2>&1; then
            sudo poweroff || poweroff || true
        fi
        ;;
    *)
        exit 0
        ;;
esac
