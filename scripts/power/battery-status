#!/usr/bin/env bash
# ==============================================================================
# battery-status: Display battery information notification via notify-send
# ==============================================================================
set -euo pipefail

info=$(upower -d 2>/dev/null | grep -E 'percentage|state|time to' | head -4 || echo "No battery info available")
notify-send -h string:x-canonical-private-synchronous:wm-bat "Battery Status" "$info"
