#!/usr/bin/env bash
# ==============================================================================
# start-mango: Wayland Session Launcher for MangoWC on Void Linux
# Sets required environment variables and boots MangoWC cleanly.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"

# Prepend desktop scripts and all component subdirectories to PATH
export PATH="$REPO_DIR/components/rofi/launcher:$REPO_DIR/components/rofi/calendar:$REPO_DIR/components/rofi/clipboard:$REPO_DIR/components/rofi/powermenu:$REPO_DIR/components/rofi/network:$REPO_DIR/components/rofi/audio:$REPO_DIR/components/rofi/screenshot:$REPO_DIR/components/rofi/wallpaper:$REPO_DIR/components/rofi/theme-selector:$REPO_DIR/components/mangobar/scripts:$REPO_DIR/components/themes:$REPO_DIR/components/wallpaper:$REPO_DIR/components/eww/scripts:$REPO_DIR/system/scripts:$REPO_DIR/system/services:$REPO_DIR/system/diagnostics:$HOME/.local/bin:$PATH"

# Session & Desktop Specifications
export XDG_CURRENT_DESKTOP=mango
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=mango

# Toolkit Wayland Backend Enforcements
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND="wayland,x11,*"
export CLUTTER_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
export NO_AT_BRIDGE=1

# Ensure XDG Runtime Directory exists
if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    if [[ ! -d "$XDG_RUNTIME_DIR" ]]; then
        mkdir -p "$XDG_RUNTIME_DIR"
        chmod 0700 "$XDG_RUNTIME_DIR"
    fi
fi

# Ensure XDG State Directory exists
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$XDG_STATE_HOME/wm"

# Configuration Path
CONFIG_FILE="$HOME/.config/mango/config.conf"
if [[ ! -f "$CONFIG_FILE" ]]; then
    CONFIG_FILE="$REPO_DIR/dotfiles/mango/config.conf"
fi

# Launch within DBus session if not already in one
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session mango -c "$CONFIG_FILE" "$@"
else
    exec mango -c "$CONFIG_FILE" "$@"
fi
