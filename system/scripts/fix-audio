#!/usr/bin/env bash
set -euo pipefail

BOLD="\033[1m"
GREEN="\033[32m"
BLUE="\033[34m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

msg_info() { echo -e "${BLUE}[INFO]${RESET} $*"; }
msg_ok()   { echo -e "${GREEN}[OK]${RESET} $*"; }
msg_warn() { echo -e "${YELLOW}[WARN]${RESET} $*"; }
msg_err()  { echo -e "${RED}[ERROR]${RESET} $*"; }

echo -e "${BOLD}==> Diagnosing and Repairing Audio Subsystem (PipeWire)...${RESET}"

CURRENT_USER="${USER:-$(id -un)}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

missing_pkgs=()
for pkg in pipewire wireplumber alsa-pipewire libspa-bluetooth; do
    if command -v xbps-query >/dev/null 2>&1; then
        if ! xbps-query -s "$pkg" 2>/dev/null | grep -q "^\[\*\]"; then
            missing_pkgs+=("$pkg")
        fi
    fi
done

if [[ ${#missing_pkgs[@]} -gt 0 ]]; then
    msg_info "Installing missing audio packages: ${missing_pkgs[*]}..."
    if sudo xbps-install -y "${missing_pkgs[@]}"; then
        msg_ok "Audio packages installed."
    else
        msg_warn "Could not install packages automatically (requires sudo)."
    fi
else
    msg_ok "All essential audio packages are installed."
fi

if getent group audio >/dev/null 2>&1; then
    if id -nG "$CURRENT_USER" | grep -qw "audio"; then
        msg_ok "User '$CURRENT_USER' is in 'audio' group."
    else
        msg_info "Adding '$CURRENT_USER' to 'audio' group..."
        if sudo usermod -aG audio "$CURRENT_USER"; then
            msg_ok "User '$CURRENT_USER' added to 'audio' group."
        else
            msg_warn "Could not add user to audio group (requires sudo)."
        fi
    fi
fi

if [[ -f /usr/share/alsa/alsa.conf.d/50-pipewire.conf ]]; then
    if sudo mkdir -p /etc/alsa/conf.d 2>/dev/null; then
        sudo ln -sf /usr/share/alsa/alsa.conf.d/50-pipewire.conf /etc/alsa/conf.d/50-pipewire.conf 2>/dev/null || true
        if [[ -f /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf ]]; then
            sudo ln -sf /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf /etc/alsa/conf.d/99-pipewire-default.conf 2>/dev/null || true
        fi
        msg_ok "ALSA PipeWire routing configured (/etc/alsa/conf.d/)."
    else
        msg_warn "Could not configure /etc/alsa/conf.d (requires sudo)."
    fi
fi

mkdir -p "$RUNTIME_DIR"
chmod 0700 "$RUNTIME_DIR" 2>/dev/null || true
export XDG_RUNTIME_DIR="$RUNTIME_DIR"

msg_info "Terminating any hung audio daemon instances..."
pkill -u "$CURRENT_USER" -x pipewire 2>/dev/null || true
pkill -u "$CURRENT_USER" -x wireplumber 2>/dev/null || true
pkill -u "$CURRENT_USER" -x pipewire-pulse 2>/dev/null || true
sleep 0.5
rm -f "$RUNTIME_DIR"/pipewire*

msg_info "Starting PipeWire audio stack..."
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
if [[ -x "$REPO_DIR/system/services/pipewire-launcher.sh" ]]; then
    "$REPO_DIR/system/services/pipewire-launcher.sh"
else
    pipewire &
    sleep 0.2
    wireplumber &
    sleep 0.2
    pipewire-pulse &
fi
sleep 0.5

if command -v wpctl >/dev/null 2>&1; then
    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 2>/dev/null || true
    sink_vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo "Active")
    msg_ok "Default audio sink unmuted ($sink_vol)."
fi

if pgrep -u "$CURRENT_USER" -x pipewire >/dev/null 2>&1 && pgrep -u "$CURRENT_USER" -x wireplumber >/dev/null 2>&1; then
    echo ""
    msg_ok "${BOLD}Audio subsystem repair complete: PipeWire and WirePlumber are active!${RESET}"
    exit 0
else
    echo ""
    msg_err "Audio daemons failed to initialize. Run 'audio-check' for detailed diagnostics."
    exit 1
fi
