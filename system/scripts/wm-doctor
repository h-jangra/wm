#!/usr/bin/env bash
# ==============================================================================
# wm-doctor: Desktop Environment Health & Diagnostic Tool
# Verifies Void Linux environment, daemons, packages, permissions, and tools.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"

total_checks=0
passed_checks=0
warning_checks=0
failed_checks=0

report_ok() {
    echo -e "  \033[32m✓ Working\033[0m: $1"
    passed_checks=$((passed_checks + 1))
    total_checks=$((total_checks + 1))
}

report_warn() {
    echo -e "  \033[33m! Warning\033[0m: $1"
    echo -e "    \033[90mHint: $2\033[0m"
    warning_checks=$((warning_checks + 1))
    total_checks=$((total_checks + 1))
}

report_fail() {
    echo -e "  \033[31m✗ Missing\033[0m: $1"
    echo -e "    \033[90mRemediation: $2\033[0m"
    failed_checks=$((failed_checks + 1))
    total_checks=$((total_checks + 1))
}

echo "========================================================"
echo "          Void Linux × MangoWC Desktop Doctor           "
echo "========================================================"
echo ""

# 1. Base OS Detection
echo "[1] Base Operating System & Packaging"
if [[ -f /etc/os-release ]]; then
    distro_id=$(grep -E '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"' | tr '[:upper:]' '[:lower:]')
    case "$distro_id" in
        void)
            report_ok "Void Linux detected"
            ;;
        arch|archarm|endeavouros|manjaro|cachyos|garuda|artix)
            report_ok "Arch Linux detected ($distro_id)"
            ;;
        debian|ubuntu|linuxmint|pop|elementary|zorin|kali)
            report_ok "Debian/Ubuntu detected ($distro_id)"
            ;;
        *)
            report_warn "Operating system is '$distro_id'" "Installer supports Void, Arch, and Debian/Ubuntu."
            ;;
    esac
else
    report_warn "/etc/os-release not found" "Cannot identify distribution."
fi

if command -v xbps-install >/dev/null 2>&1; then
    report_ok "XBPS package manager present"
elif command -v pacman >/dev/null 2>&1; then
    report_ok "Pacman package manager present"
elif command -v apt-get >/dev/null 2>&1; then
    report_ok "APT package manager present"
else
    report_warn "Supported package manager not found in PATH" "Ensure xbps-install, pacman, or apt-get is available."
fi

# 2. Compositor & Session
echo ""
echo "[2] Wayland Compositor & Session"
if command -v mangowc >/dev/null 2>&1 || command -v mango >/dev/null 2>&1; then
    bin_name="$(command -v mangowc 2>/dev/null || command -v mango 2>/dev/null)"
    report_ok "MangoWC binary found ($bin_name)"
    if ! command -v mangowc >/dev/null 2>&1; then
        report_warn "Command 'mangowc' alias not found (binary is '$bin_name')" "Create link: ln -sf $bin_name ~/.local/bin/mangowc"
    fi
else
    report_fail "MangoWC binary not found" "Build or install mangowc via void-packages."
fi

if command -v mmsg >/dev/null 2>&1; then
    report_ok "mmsg IPC client found"
else
    report_fail "mmsg IPC client not found" "Install mmsg alongside MangoWC."
fi

if [[ -x "$REPO_DIR/system/scripts/start-mango" || -x "$(command -v start-mango 2>/dev/null || true)" ]]; then
    report_ok "Session startup script (start-mango) is executable"
else
    report_fail "start-mango script not executable or not found" "Run: chmod +x $REPO_DIR/system/scripts/start-mango"
fi

if [[ -f /usr/share/wayland-sessions/mango.desktop || -f "$HOME/.local/share/wayland-sessions/mango.desktop" ]]; then
    session_path="/usr/share/wayland-sessions/mango.desktop"
    [[ -f "$session_path" ]] || session_path="$HOME/.local/share/wayland-sessions/mango.desktop"
    report_ok "Wayland session entry found ($session_path)"
    if grep -qE "^Exec=.*dbus-run-session.*mangowc" "$session_path" 2>/dev/null; then
        report_ok "Session command configured with DBus: $(grep -E '^Exec=' "$session_path")"
    else
        report_warn "Session entry does not use 'Exec=dbus-run-session mangowc'" "Update via: sudo cp $REPO_DIR/system/services/mango.desktop /usr/share/wayland-sessions/"
    fi
else
    report_warn "Wayland session entry not installed in /usr/share/wayland-sessions/" "Deploy via: sudo cp $REPO_DIR/system/services/mango.desktop /usr/share/wayland-sessions/"
fi

# 3. Core UI Components
echo ""
echo "[3] Desktop Shell & Menus"
if [[ -f "$REPO_DIR/config/themes/generated/palette.css" || -f "$HOME/.cache/wm-palette.css" || -f "$HOME/.cache/wm/palette.css" ]]; then
    report_ok "Dynamic theme palette active (config/themes/generated/palette.css)"
else
    report_warn "Dynamic theme palette not generated" "Run: $REPO_DIR/config/themes/theme-from-wallpaper"
fi

if command -v rofi >/dev/null 2>&1; then
    report_ok "Rofi found ($(rofi -v 2>&1 | head -n1))"
else
    report_fail "Rofi not found" "Run: sudo xbps-install -Sy rofi-wayland"
fi

if command -v mangobar >/dev/null 2>&1; then
    report_ok "MangoBar status bar found ($(mangobar -v 2>&1 | head -n1))"
else
    report_fail "MangoBar not found" "Install mangobar from https://github.com/mangowm/mangobar"
fi

if [[ -d "$HOME/.config/mangobar" && -f "$HOME/.config/mangobar/config.jsonc" ]]; then
    report_ok "MangoBar user configuration valid (~/.config/mangobar/config.jsonc)"
else
    report_warn "MangoBar user config missing" "Link via: ln -sfn $REPO_DIR/config/mangobar ~/.config/mangobar"
fi

if command -v foot >/dev/null 2>&1; then
    report_ok "Foot terminal found ($(foot --version 2>&1 | head -n1))"
else
    report_fail "Foot terminal not found" "Run: sudo xbps-install -Sy foot"
fi

if command -v mako >/dev/null 2>&1; then
    report_ok "Mako notification daemon found"
else
    report_fail "Mako not found" "Run: sudo xbps-install -Sy mako"
fi

if command -v notify-send >/dev/null 2>&1; then
    report_ok "libnotify (notify-send) found"
else
    report_fail "notify-send not found" "Run: sudo xbps-install -Sy libnotify"
fi

# 4. Audio Stack
echo ""
echo "[4] PipeWire & WirePlumber Audio Stack"
if command -v pipewire >/dev/null 2>&1 && command -v wireplumber >/dev/null 2>&1; then
    report_ok "PipeWire and WirePlumber packages installed"
else
    report_fail "PipeWire or WirePlumber missing" "Run: sudo xbps-install -Sy pipewire wireplumber alsa-pipewire"
fi

if pgrep -x pipewire >/dev/null 2>&1 && pgrep -x wireplumber >/dev/null 2>&1; then
    report_ok "PipeWire and WirePlumber daemons are active"
else
    report_warn "PipeWire or WirePlumber daemons not running" "Start via $REPO_DIR/system/services/pipewire-launcher.sh"
fi

# 5. Networking & Bluetooth
echo ""
echo "[5] Networking & Bluetooth"
if command -v nmcli >/dev/null 2>&1; then
    report_ok "NetworkManager (nmcli) found"
else
    report_fail "NetworkManager missing" "Run: sudo xbps-install -Sy NetworkManager"
fi

if command -v bluetoothctl >/dev/null 2>&1; then
    report_ok "BlueZ (bluetoothctl) found"
else
    report_fail "BlueZ missing" "Run: sudo xbps-install -Sy bluez"
fi

# 6. System Services & IPC
echo ""
echo "[6] System Daemons & IPC"
if pgrep -x dbus-daemon >/dev/null 2>&1 || pgrep -x dbus-broker >/dev/null 2>&1; then
    report_ok "DBus daemon is running"
else
    report_fail "DBus daemon is not running" "Enable runit service: sudo ln -s /etc/sv/dbus /var/service/"
fi

if command -v loginctl >/dev/null 2>&1; then
    report_ok "elogind (loginctl) found"
else
    report_warn "elogind not found" "Install elogind for clean seat and power management."
fi

# Polkit agent check
polkit_agent=""
for agent in \
    "/usr/libexec/polkit-gnome-authentication-agent-1" \
    "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1" \
    "/usr/libexec/polkit-mate-authentication-agent-1" \
    "/usr/lib/xfce-polkit/xfce-polkit"; do
    if [[ -x "$agent" ]]; then
        polkit_agent="$agent"
        break
    fi
done
if [[ -n "$polkit_agent" ]]; then
    report_ok "Polkit authentication agent found ($polkit_agent)"
else
    report_warn "Polkit authentication agent not found" "Install: sudo xbps-install -Sy polkit-gnome"
fi

# 7. Hardware & Permissions
echo ""
echo "[7] Hardware Controls & Groups"
if command -v brightnessctl >/dev/null 2>&1; then
    report_ok "brightnessctl found"
else
    report_warn "brightnessctl missing" "Run: sudo xbps-install -Sy brightnessctl"
fi

user_groups=$(groups || true)
if echo "$user_groups" | grep -qw "video"; then
    report_ok "User is in 'video' group (webcam & backlight)"
else
    report_warn "User is NOT in 'video' group" "Run: sudo usermod -aG video \$USER (or run fix-video)"
fi

if echo "$user_groups" | grep -qw "audio"; then
    report_ok "User is in 'audio' group"
else
    report_warn "User is NOT in 'audio' group" "Run: sudo usermod -aG audio \$USER (or run fix-audio)"
fi

if compgen -G "/dev/video*" >/dev/null; then
    report_ok "Webcam / V4L2 device nodes present (/dev/video*)"
else
    report_warn "No /dev/video* devices found" "Webcam not detected or blocked. Run: fix-video"
fi

if command -v v4l2-ctl >/dev/null 2>&1; then
    report_ok "v4l-utils (v4l2-ctl) installed"
else
    report_warn "v4l-utils missing" "Install: sudo xbps-install -Sy v4l-utils (or run fix-video)"
fi

# 8. Tools & Assets
echo ""
echo "[8] Utilities & Assets"
if command -v grim >/dev/null 2>&1 && command -v slurp >/dev/null 2>&1 && command -v wl-copy >/dev/null 2>&1; then
    report_ok "Screenshot & clipboard tools found (grim, slurp, wl-clipboard)"
else
    report_fail "Screenshot/clipboard tools missing" "Run: sudo xbps-install -Sy grim slurp wl-clipboard"
fi

if command -v swaybg >/dev/null 2>&1; then
    report_ok "swaybg wallpaper renderer found"
else
    report_fail "swaybg missing" "Run: sudo xbps-install -Sy swaybg"
fi

if command -v thunar >/dev/null 2>&1; then
    report_ok "Thunar file manager found ($(command -v thunar))"
else
    report_warn "Thunar file manager not found" "Run: sudo xbps-install -Sy Thunar"
fi

if [[ -d "$REPO_DIR/config/themes/presets" && $(find "$REPO_DIR/config/themes/presets" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) | wc -l) -gt 0 ]]; then
    report_ok "Curated wallpapers found in theme presets"
elif [[ -d "$HOME/Pictures/Wallpapers" && $(find "$HOME/Pictures/Wallpapers" -type f | wc -l) -gt 0 ]]; then
    report_ok "Wallpapers found in ~/Pictures/Wallpapers"
else
    report_warn "No wallpapers detected" "Add wallpapers to theme presets or ~/Pictures/Wallpapers"
fi

# 9. Fonts & Typography
echo ""
echo "[9] Fonts & Typography"
if fc-list : family 2>/dev/null | grep -qiE "(JetBrainsMono|Nerd Font|Icomoon|Material)"; then
    report_ok "Nerd Font or icon font detected on system"
else
    report_warn "No Nerd Font detected" "Install fonts via install.sh or xbps-install nerd-fonts."
fi

# 10. Login Manager (Optional: Ly)
echo ""
echo "[10] Login Manager (Optional: Ly)"
if command -v ly >/dev/null 2>&1; then
    report_ok "Ly binary installed ($(command -v ly))"

    if [[ -f /etc/ly/config.ini ]]; then
        report_ok "Ly configuration present (/etc/ly/config.ini)"
    fi

    if [[ -d /var/service/ly || -L /var/service/ly || -d /var/service/ly-runit-service || -L /var/service/ly-runit-service ]]; then
        report_ok "Ly runit service is active in /var/service/"
    elif [[ -d /etc/sv/ly || -d /etc/sv/ly-runit-service ]]; then
        report_warn "Ly service defined in /etc/sv/ but not enabled in /var/service/" "Enable: sudo ln -s /etc/sv/ly /var/service/"
    fi
else
    report_warn "Ly display manager not installed (Optional - TTY login active)" "Install Ly for graphical/TUI login"
fi

# Check for display manager conflicts
active_dms=()
for dm in "ly" "ly-runit-service" "sddm" "lightdm" "gdm" "lxdm" "greetd"; do
    if [[ -d "/var/service/$dm" || -L "/var/service/$dm" ]]; then
        # Avoid counting ly and ly-runit-service as separate competing DMs if both point to same service
        if [[ "$dm" == "ly-runit-service" ]] && echo "${active_dms[*]}" | grep -qw "ly"; then
            continue
        fi
        active_dms+=("$dm")
    fi
done

if [[ ${#active_dms[@]} -gt 1 ]]; then
    report_fail "Multiple display managers active in /var/service/: ${active_dms[*]}" "Under runit, disable all but one: sudo rm /var/service/<dm>"
elif [[ ${#active_dms[@]} -eq 1 ]]; then
    report_ok "Single active display manager in /var/service/: ${active_dms[0]}"
else
    report_ok "No display manager enabled in /var/service/ (Pure TTY boot flow)"
fi

# Summary Dashboard
echo ""
echo "========================================================"
echo "                   Doctor Dashboard                     "
echo "========================================================"
echo "  $(command -v mango >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[31m✗\033[0m') MangoWC Compositor"
echo "  $(([[ -f /usr/share/wayland-sessions/mango.desktop || -f "$HOME/.local/share/wayland-sessions/mango.desktop" ]]) && echo -e '\033[32m✓\033[0m' || echo -e '\033[33m!\033[0m') Session File (mango.desktop)"
echo "  $(command -v mangobar >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[31m✗\033[0m') MangoBar (Status Bar)"
echo "  $(command -v rofi >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[31m✗\033[0m') Rofi (Launcher & Menus)"
echo "  $(command -v foot >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[31m✗\033[0m') Foot"
echo "  $(command -v thunar >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[33m!\033[0m') Thunar"
echo "  $(command -v mako >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[31m✗\033[0m') Mako"
echo "  $(command -v pipewire >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[31m✗\033[0m') PipeWire"
echo "  $(command -v wireplumber >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[31m✗\033[0m') WirePlumber"
echo "  $(compgen -G '/dev/video*' >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[33m!\033[0m') Webcam (/dev/video*)"
echo "  $(command -v nmcli >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[31m✗\033[0m') NetworkManager"
echo "  $(command -v bluetoothctl >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[31m✗\033[0m') BlueZ"
echo "  $((pgrep -x dbus-daemon >/dev/null || pgrep -x dbus-broker >/dev/null) && echo -e '\033[32m✓\033[0m' || echo -e '\033[31m✗\033[0m') DBus"
echo "  $(command -v loginctl >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[33m!\033[0m') elogind"
echo "  $([[ -n "$polkit_agent" ]] && echo -e '\033[32m✓\033[0m' || echo -e '\033[33m!\033[0m') polkit"
echo "  $(command -v ly >/dev/null && echo -e '\033[32m✓\033[0m' || echo -e '\033[90m-\033[0m') Ly DM (Optional)"
echo "========================================================"
echo "Checks: $passed_checks passed, $warning_checks warnings, $failed_checks failed (total $total_checks checks)"
echo "========================================================"

if [[ $failed_checks -eq 0 ]]; then
    echo -e "\033[32m✓ System environment is ready for MangoWC desktop!\033[0m"
    exit 0
else
    echo -e "\033[31m✗ Some critical components are missing. See remediation steps above.\033[0m"
    exit 1
fi
