{
    "layer": "top",
    "height": 30,
    "buffer-scale": 1,

    "modules-left": [
        "clock#time",
        "clock#date"
    ],
    "modules-center": [
        "workspaces"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "memory",
        "backlight",
        "battery",
        "tray",
        "custom/power"
    ],

    "workspaces": {
        "hide-empty": true,
        "tag-names": ["一", "二", "三", "四", "五", "六", "七", "八", "九"],
        // "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle"
    },

    "clock#time": {
        "format": " {:L%H:%M}",
        "on-click": "rofi-calendar"
    },
    "clock#date": {
        "format": " {:L%a, %b %d}",
        "on-click": "rofi-calendar"
    },

    "network": {
        "format": "󰤨",
        "on-click": "launch-wifi"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "icons": ["󰝟", "󰕿", "󰕾"],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "launch-audio",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },

    "memory": {
        "format": "󰍛 {}",
        "on-click": "launch-btop"
    },

    "backlight": {
        "format": "{icon}",
        "icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "format": "{icon} {percent}%",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "on-click": "battery-status"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    "custom/power": {
        "format": "󰐥",
        "on-click": "rofi-powermenu"
    }
}
