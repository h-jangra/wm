#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
RUN="${XDG_RUNTIME_DIR:-/tmp}/wm-recorder"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/wm"
PID="$RUN/pid"
FILE="$RUN/file"
AUDIO="$CFG/recorder_audio"
GET_WINDOW="$DIR/get_window"
ROFI_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/recorder/recorder.rasi"

mkdir -p "$RUN" "$CFG"

notify() {
    notify-send -h string:x-canonical-private-synchronous:wm-record "Screen Recorder" "$1" 2>/dev/null || true
}

is_recording() {
    if [[ -f "$PID" ]]; then
        local pid
        pid=$(cat "$PID" 2>/dev/null || true)
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$PID" "$FILE" 2>/dev/null || true
    fi
    return 1
}

signal_bar() {
    pkill -SIGRTMIN+1 mangobar 2>/dev/null || true
}

status() {
    if is_recording; then
        echo "󰻃"
    else
        echo ""
    fi
}

stop() {
    if ! is_recording; then
        rm -f "$PID" "$FILE" 2>/dev/null || true
        signal_bar
        return 0
    fi

    local pid file
    pid=$(cat "$PID" 2>/dev/null || true)
    file=$(cat "$FILE" 2>/dev/null || true)

    if [[ -n "$pid" ]]; then
        kill -INT "$pid" 2>/dev/null || true
        for _ in {1..30}; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
        kill -9 "$pid" 2>/dev/null || true
    fi

    rm -f "$PID" "$FILE" 2>/dev/null || true
    signal_bar

    if [[ -n "$file" && -f "$file" ]]; then
        notify "Recording saved: $(basename "$file")"
    else
        notify "Recording stopped"
    fi
}

record() {
    if is_recording; then
        stop
        return 0
    fi

    local geometry="${1:-}"
    local dir="$HOME/Videos/Recordings"
    local file="$dir/Recording_$(date +%Y-%m-%d_%H-%M-%S).mp4"
    local args=(-D -c libx264 -p preset=ultrafast -p crf=22 -x yuv420p)

    mkdir -p "$dir"

    case "$(cat "$AUDIO" 2>/dev/null || echo none)" in
        mic|microphone)
            local src
            src="$(pactl get-default-source 2>/dev/null || true)"
            [[ -n "$src" ]] && args+=(--audio="$src" -C aac) || args+=(--audio -C aac)
            ;;
        sys|system|desktop)
            local sink
            sink="$(pactl get-default-sink 2>/dev/null || true)"
            [[ -n "$sink" ]] && args+=(--audio="${sink}.monitor" -C aac)
            ;;
    esac

    [[ -n "$geometry" ]] && args+=(-g "$geometry")

    setsid wf-recorder "${args[@]}" -f "$file" </dev/null >/dev/null 2>&1 &
    local rec_pid=$!
    echo "$rec_pid" > "$PID"
    echo "$file" > "$FILE"

    signal_bar
}

region() {
    if is_recording; then
        stop
        return 0
    fi

    local geometry=""
    if [[ -x "$GET_WINDOW" ]]; then
        geometry=$("$GET_WINDOW" 2>/dev/null | slurp 2>/dev/null || true)
    else
        geometry=$(slurp 2>/dev/null || true)
    fi

    [[ -n "$geometry" ]] && record "$geometry"
}

menu() {
    local rofi_args=(-dmenu -i -p "Recorder")
    [[ -f "$ROFI_THEME" ]] && rofi_args+=(-theme "$ROFI_THEME")

    if is_recording; then
        local choice
        choice=$(printf '%s\n' "󰻃  Stop Recording" | rofi "${rofi_args[@]}") || return 0
        [[ "$choice" =~ "Stop" ]] && stop
        return 0
    fi

    local audio_mode
    audio_mode="$(cat "$AUDIO" 2>/dev/null || echo none)"

    local none="󰕲  Audio: None"
    local mic="󰍬  Audio: Microphone"
    local sys="󰓃  Audio: System Audio"

    case "$audio_mode" in
        mic|microphone) mic+="  ✓" ;;
        sys|system|desktop) sys+="  ✓" ;;
        *) none+="  ✓" ;;
    esac

    local choice
    choice=$(printf '%s\n' \
        "󰹑  Record Region" \
        "󰍹  Record Fullscreen" \
        "$none" \
        "$mic" \
        "$sys" | rofi "${rofi_args[@]}") || return 0

    case "$choice" in
        *"Record Region"*)
            region
            ;;
        *"Record Fullscreen"*)
            record
            ;;
        *"Audio: None"*)
            echo "none" > "$AUDIO"
            notify "Audio set to None"
            ;;
        *"Audio: Microphone"*)
            echo "microphone" > "$AUDIO"
            notify "Audio set to Microphone"
            ;;
        *"Audio: System Audio"*)
            echo "system" > "$AUDIO"
            notify "Audio set to System Audio"
            ;;
    esac
}

case "${1:-status}" in
    status) status ;;
    region) region ;;
    fullscreen) record ;;
    stop) stop ;;
    toggle) is_recording && stop || region ;;
    menu) menu ;;
    set-audio) echo "${2:-none}" > "$AUDIO" ;;
    get-audio) cat "$AUDIO" 2>/dev/null || echo none ;;
    *) region ;;
esac
