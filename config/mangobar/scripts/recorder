#!/usr/bin/env bash
# ==============================================================================
# recorder: Wayland screen recorder for mangobar using wf-recorder & get_window
# Left click: select region or active window (get_window | slurp) to record
# Right click: start full-screen recording
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
GET_WINDOW="$SCRIPT_DIR/get_window"

RUN_DIR="${XDG_RUNTIME_DIR:-/dev/shm}/wm_recorder"
mkdir -p "$RUN_DIR"

PID_FILE="$RUN_DIR/pid"
FILE_FILE="$RUN_DIR/file"
GEOM_FILE="$RUN_DIR/geom"

notify() {
    local icon="${1:-}"
    local title="${2:-Screen Recorder}"
    local msg="${3:-}"
    if [[ -n "$icon" ]]; then
        notify-send -h string:x-canonical-private-synchronous:wm-record -i "$icon" "$title" "$msg" 2>/dev/null || true
    else
        notify-send -h string:x-canonical-private-synchronous:wm-record "$title" "$msg" 2>/dev/null || true
    fi
}

is_recording() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    rm -f "$PID_FILE" "$FILE_FILE" "$GEOM_FILE" 2>/dev/null || true
    return 1
}

signal_mangobar() {
    pkill -SIGRTMIN+1 mangobar 2>/dev/null || true
}

get_status() {
    if is_recording; then
        echo "󰻃"
    else
        echo ""
    fi
}

stop_recording() {
    if is_recording; then
        local pid file
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        file=$(cat "$FILE_FILE" 2>/dev/null || true)

        if [[ -n "$pid" ]]; then
            kill -INT "$pid" 2>/dev/null || true
            # Wait up to 3 seconds for wf-recorder to flush container
            for _ in {1..30}; do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.1
            done
        fi

        rm -f "$PID_FILE" "$FILE_FILE" "$GEOM_FILE" 2>/dev/null || true
        signal_mangobar
        notify "video-x-generic" "Recording Saved" "${file:-Saved to ~/Videos/Recordings}"
    fi
}

start_region() {
    if is_recording; then
        stop_recording
        return 0
    fi

    # Select geometry using get_window (predefined window rectangles) + slurp
    local geom=""
    if [[ -x "$GET_WINDOW" ]]; then
        geom=$("$GET_WINDOW" 2>/dev/null | slurp 2>/dev/null || true)
    elif command -v get_window >/dev/null 2>&1; then
        geom=$(get_window 2>/dev/null | slurp 2>/dev/null || true)
    else
        geom=$(slurp 2>/dev/null || true)
    fi

    if [[ -z "$geom" ]]; then
        # Selection canceled (e.g. Escape pressed)
        signal_mangobar
        exit 0
    fi

    local save_dir="$HOME/Videos/Recordings"
    mkdir -p "$save_dir"
    local filename="$save_dir/Recording_$(date +%Y-%m-%d_%H-%M-%S).mp4"

    # Start wf-recorder in background
    wf-recorder -D -g "$geom" -f "$filename" >/dev/null 2>&1 &
    local rec_pid=$!

    echo "$rec_pid" > "$PID_FILE"
    echo "$filename" > "$FILE_FILE"
    echo "$geom" > "$GEOM_FILE"

    signal_mangobar
    # notify "media-record" "Recording Started" "Region: $geom"
}

start_fullscreen() {
    if is_recording; then
        stop_recording
        return 0
    fi

    local save_dir="$HOME/Videos/Recordings"
    mkdir -p "$save_dir"
    local filename="$save_dir/Recording_$(date +%Y-%m-%d_%H-%M-%S).mp4"

    wf-recorder -D -f "$filename" >/dev/null 2>&1 &
    local rec_pid=$!

    echo "$rec_pid" > "$PID_FILE"
    echo "$filename" > "$FILE_FILE"
    echo "fullscreen" > "$GEOM_FILE"

    signal_mangobar
    # notify "media-record" "Recording Started" "Full Screen"
}

case "${1:-status}" in
    status)
        get_status
        ;;
    region)
        start_region
        ;;
    fullscreen)
        start_fullscreen
        ;;
    stop)
        stop_recording
        ;;
    toggle)
        if is_recording; then
            stop_recording
        else
            start_region
        fi
        ;;
    *)
        if is_recording; then
            stop_recording
        else
            start_region
        fi
        ;;
esac
