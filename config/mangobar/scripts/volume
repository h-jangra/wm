#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
ICON_DIR="${REPO_DIR}/assets/icons"

notify_vol() {
    local vol="$1"
    local icon="${ICON_DIR}/volume-high.svg"
    if [[ "$vol" -eq 0 ]]; then
        icon="${ICON_DIR}/volume-mute.svg"
    elif [[ "$vol" -le 35 ]]; then
        icon="${ICON_DIR}/volume-low.svg"
    elif [[ "$vol" -le 70 ]]; then
        icon="${ICON_DIR}/volume-mid.svg"
    fi

    notify-send -h string:x-canonical-private-synchronous:wm-osd-vol \
                -h int:value:"$vol" \
                -i "$icon" \
                "Volume: ${vol}%"
}

notify_mute() {
    notify-send -h string:x-canonical-private-synchronous:wm-osd-vol \
                -i "${ICON_DIR}/volume-mute.svg" \
                "Volume: Muted"
}

notify_mic() {
    local status="$1"
    local icon="${ICON_DIR}/microphone.svg"
    if [[ "$status" == "Muted" ]]; then
        icon="${ICON_DIR}/microphone-mute.svg"
    fi
    notify-send -h string:x-canonical-private-synchronous:wm-osd-mic \
                -i "$icon" \
                "Microphone: $status"
}

cmd="${1:---get}"

case "$cmd" in
    --inc)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
        vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}')
        notify_vol "$vol"
        ;;
    --dec)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
        vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}')
        notify_vol "$vol"
        ;;
    --toggle)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        if wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q "MUTED"; then
            notify_mute
        else
            vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}')
            notify_vol "$vol"
        fi
        ;;
    --toggle-mic)
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q "MUTED"; then
            notify_mic "Muted"
        else
            notify_mic "Active"
        fi
        ;;
    --get)
        wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}'
        ;;
    *)
        echo "Usage: $0 {--inc|--dec|--toggle|--toggle-mic|--get}"
        exit 1
        ;;
esac
