#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
PRESETS_DIR="${REPO_DIR}/config/themes/presets"
USER_WALLPAPER_DIR="$HOME/Pictures/Wallpapers"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wm"
mkdir -p "$CACHE_DIR"
CACHE_FILE="${CACHE_DIR}/current_wallpaper"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wm"
mkdir -p "$STATE_DIR"
MODE_FILE="${STATE_DIR}/current_mode"
THEME_FILE="${STATE_DIR}/current"

notify() {
    notify-send -h string:x-canonical-private-synchronous:wm-wall "Wallpaper" "$1"
}

cmd="${1:-restore}"

case "$cmd" in
    set)
        target="${2:-}"
        skip_theme="${3:-}"

        if [[ -z "$target" || ! -f "$target" ]]; then
            echo "Error: Wallpaper file not found: '$target'" >&2
            exit 1
        fi

        target=$(readlink -f "$target")
        render_target="$target"
        if [[ "$target" == *.webp ]]; then
            converted="$CACHE_DIR/current_rendered_wallpaper.jpg"
            if command -v ffmpeg >/dev/null 2>&1; then
                if ffmpeg -y -v error -i "$target" -q:v 2 -update 1 "$converted" 2>/dev/null; then
                    render_target="$converted"
                fi
            fi
        fi

        if command -v swaybg >/dev/null 2>&1; then
            swaybg -i "$render_target" -m fill >/dev/null 2>&1 &
            new_pid=$!
            disown "$new_pid" 2>/dev/null || true
            sleep 0.2

            for pid in $(pgrep -x swaybg || true); do
                if [[ "$pid" -ne "$new_pid" ]]; then
                    kill "$pid" >/dev/null 2>&1 || true
                fi
            done
        else
            notify "Warning: swaybg is not installed."
        fi

        echo "$target" > "$CACHE_FILE"

        current_mode="static"
        [[ -f "$MODE_FILE" ]] && current_mode=$(cat "$MODE_FILE" | tr -d '[:space:]')

        if [[ "$current_mode" == "dynamic" && "$skip_theme" != "--skip-theme" ]]; then
            theme_from_wall="$(command -v theme-from-wallpaper || true)"
            [[ -z "$theme_from_wall" ]] && theme_from_wall="${REPO_DIR}/config/themes/theme-from-wallpaper"
            if [[ -x "$theme_from_wall" ]]; then
                "$theme_from_wall" "$target" >/dev/null 2>&1 || true
            fi
        fi
        ;;

    restore)
        if [[ -f "$CACHE_FILE" ]]; then
            cached=$(cat "$CACHE_FILE")
            if [[ -f "$cached" ]]; then
                exec "$0" set "$cached" --skip-theme
            fi
        fi
        legacy_cache="$HOME/.cache/current_wallpaper"
        if [[ -f "$legacy_cache" ]]; then
            cached=$(cat "$legacy_cache")
            if [[ -f "$cached" ]]; then
                exec "$0" set "$cached" --skip-theme
            fi
        fi

        current_theme="catppuccin-mocha"
        [[ -f "$THEME_FILE" ]] && current_theme=$(cat "$THEME_FILE" | tr -d '[:space:]')
        if [[ -d "$PRESETS_DIR/$current_theme/wallpapers" ]]; then
            first_theme_wall=$(find -L "$PRESETS_DIR/$current_theme/wallpapers" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) | head -n1 || true)
            if [[ -n "$first_theme_wall" ]]; then
                exec "$0" set "$first_theme_wall" --skip-theme
            fi
        fi

        first_found=$(find "$PRESETS_DIR" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | head -n1 || true)
        if [[ -n "$first_found" ]]; then
            exec "$0" set "$first_found" --skip-theme
        fi
        ;;

    random)
        category="${2:-}"
        search_dirs=()
        if [[ -d "$USER_WALLPAPER_DIR" ]]; then
            search_dirs+=("$USER_WALLPAPER_DIR")
        fi
        if [[ -n "$category" && -d "$PRESETS_DIR/$category/wallpapers" ]]; then
            search_dirs+=("$PRESETS_DIR/$category/wallpapers")
        elif [[ -d "$PRESETS_DIR" ]]; then
            for pdir in "$PRESETS_DIR"/*/wallpapers; do
                [[ -d "$pdir" ]] && search_dirs+=("$pdir")
            done
        fi

        random_file=$(find "${search_dirs[@]}" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | shuf -n1 || true)
        if [[ -n "$random_file" ]]; then
            exec "$0" set "$random_file"
        else
            notify "No wallpapers found"
        fi
        ;;

    *)
        echo "Usage: $0 {set <path> [--skip-theme]|restore|random [category]}"
        exit 1
        ;;
esac
