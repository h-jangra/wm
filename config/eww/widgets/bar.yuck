; Tray
(defwidget tray []
  (box
    :class "tray"
    :halign "end"
    :space-evenly false
    (eventbox
      :cursor "pointer"
      :onclick "launch-wifi"
      (box
        :class "tray-item wifi"
        :spacing 0
        :space-evenly false
        (image :class "icon wifi-icon" :path {wifi-icon != "" ? wifi-icon : "assets/wifi-off.svg"} :image-height "20")
        (label :class "text wifi-text" :text wifi-strength)))
    (eventbox
      :cursor "pointer"
      :onclick "launch-bluetooth"
      (box
        :class "tray-item bt"
        :spacing 0
        :space-evenly false
        (image :class "icon bt-icon" :path {bt-icon != "" ? bt-icon : "assets/bluetooth.svg"} :image-height "20")))
    (eventbox
      :cursor "pointer"
      :onclick "launch-audio"
      :onrightclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
      :onscroll "if [ '{}' = 'up' ]; then wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; else wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; fi"
      (box
        :class "tray-item vol"
        :spacing 0
        :space-evenly false
        (image :class "icon vol-icon" :path {vol-icon != "" ? vol-icon : "assets/volume-high.svg"} :image-height "20")
        (label :class "text vol-text" :text "${vol-num}%")))
    (eventbox
      :cursor "pointer"
      :onclick "launch-btop 2>/dev/null || footclient -e btop &"
      (box
        :class "tray-item mem"
        :spacing 0
        :space-evenly false
        (image :class "icon mem-icon" :path "assets/memory.svg" :image-height "20")
        (label :class "text mem-text" :text memory)))
    (eventbox
      :cursor "pointer"
      :onclick "battery-status 2>/dev/null || true"
      (box
        :class "tray-item bat"
        :spacing 0
        :space-evenly false
        (image :class "icon bat-icon" :path {bat-icon != "" ? bat-icon : "assets/battery-charging.svg"} :image-height "26")
        (label :class "text bat-text" :text "${bat-num}%")))
    (eventbox
      :cursor "pointer"
      :onscroll "if [ '{}' = 'up' ]; then brightnessctl set +5%; else brightnessctl set 5%-; fi"
      (box
        :class "tray-item br"
        :spacing 0
        :space-evenly false
        (image :class "icon br-icon" :path "assets/brightness.svg" :image-height "20")))
    (box
      :class "tray-item"
      :spacing 0
      :space-evenly false
      (systray
        :spacing 10
        :orientation "h"
        :space-evenly true
        :icon-size "20"))))

; Workspaces
(defwidget workspaces []
  (box
    :class "workspaces"
    :halign "center"
    :hexpand false
    (literal :content numworkspaces)))

; Minimal Left Area: Time & Click-to-reveal Date
(defwidget left []
  (box
    :class "left"
    :halign "start"
    :space-evenly false
    :spacing 0
    (eventbox
      :cursor "pointer"
      :onclick "eww update show-date=${!show-date}"
      (box
        :class "time"
        :space-evenly false
        :spacing 0
        (label :class "text" :text time)))
    (revealer
      :transition "slideright"
      :reveal show-date
      :duration "250ms"
      (eventbox
        :cursor "pointer"
        :onclick "eww update show-date=false"
        (box
          :class "date"
          :halign "start" 
          :spacing 0
          :space-evenly false
          (image :class "icon date-icon" :path "assets/calendar.svg" :image-width "18" :image-height "18")
          (label :class "text" :text date))))))

(defwidget center []
  (box
    :class "center"
    :halign "center"
    :space-evenly false
    (workspaces)))

(defwidget bar []
  (centerbox
    :orientation "h"
    :class "bar"
    (left)
    (center)
    (tray)))

(defwindow bar
  :stacking "fg"
  :monitor "0"
  :exclusive true
  :focusable false
  :namespace "bar"
  :geometry (geometry
    :x "0px"
    :y "0%"
    :width "100%"
    :height "0%"
    :anchor "top center")
  (bar))
