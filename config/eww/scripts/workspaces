#!/usr/bin/env bash
# ==============================================================================
# workspaces: MangoWC workspace stream for Eww status bar
# Fast, lightweight Bash + jq streaming from mmsg
# ==============================================================================
set -euo pipefail

JQ_FILTER='
def kanji:
  if . == 1 then "一"
  elif . == 2 then "二"
  elif . == 3 then "三"
  elif . == 4 then "四"
  elif . == 5 then "五"
  elif . == 6 then "六"
  elif . == 7 then "七"
  elif . == 8 then "八"
  elif . == 9 then "九"
  elif . == 10 then "十"
  else tostring end;

(.all_tags // []) as $monitors |
if ($monitors | length) == 0 then
  "(box :space-evenly false :spacing 0 :vexpand true :hexpand false (label :class \"active-monitor-ws\" :text \"一\"))"
else
  (($monitors[] | select(.active == true)) // $monitors[0]) as $target |
  ([ $target.tags[]? |
     select(.is_active == true or .is_urgent == true or .client_count > 0) |
     (if .is_active == true or .is_urgent == true then "active-monitor-ws"
      elif .client_count > 0 then "occupied-ws"
      else empty end) as $cls |
     "(eventbox :cursor \"pointer\" :onclick \"mmsg dispatch view,\(.index)\" (label :class \"\($cls)\" :text \"\(.index | kanji)\"))"
   ] | join("")) as $buttons |
   "(eventbox :onscroll \"if [ \\\"{}\\\" = \\\"up\\\" ]; then mmsg dispatch viewtoleft; else mmsg dispatch viewtoright; fi\" (box :space-evenly false :spacing 0 :vexpand true :hexpand false \($buttons)))"
end
'

# Emit initial state if mmsg is available
if command -v mmsg >/dev/null 2>&1; then
    mmsg get all-tags 2>/dev/null | jq -r -c --unbuffered "$JQ_FILTER" 2>/dev/null || true
    exec mmsg watch all-tags 2>/dev/null | jq -r -c --unbuffered "$JQ_FILTER"
else
    echo '(box :space-evenly false :spacing 0 :vexpand true :hexpand false (label :class "active-monitor-ws" :text "一"))'
fi
