#!/usr/bin/env bash

eww close brightness_osd 2>/dev/null || true

LOCK_FILE="/tmp/eww_volume_osd"
echo $$ > "$LOCK_FILE"

eww open volume_osd 2>/dev/null || true

sleep 2

if [[ -f "$LOCK_FILE" ]] && [[ "$(cat "$LOCK_FILE" 2>/dev/null)" -eq $$ ]]; then
  eww close volume_osd 2>/dev/null || true
  rm -f "$LOCK_FILE"
fi
