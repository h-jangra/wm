#!/bin/bash

get_br() {
  brightnessctl g 2>/dev/null | awk -v max="$(brightnessctl m 2>/dev/null)" '{if (max > 0) printf "%d\n", ($1/max)*100; else print "100"}'
}

get_br

if command -v inotifywait >/dev/null 2>&1; then
  inotifywait -m -e modify /sys/class/backlight/*/brightness 2>/dev/null | while read -r _; do
    get_br
  done
else
  last=""
  while true; do
    curr=$(get_br)
    if [[ "$curr" != "$last" ]]; then
      echo "$curr"
      last="$curr"
    fi
    sleep 1
  done
fi
