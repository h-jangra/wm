configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               " Apps";
    display-run:                " Run";
    drun-display-format:        "{name}";
    run-display-format:         "{name}";
    kb-mode-next:               "Tab,Shift+Right,Control+Tab";
    kb-mode-previous:           "BackTab,ISO_Left_Tab,Shift+Left";
    kb-element-next:            "";
    kb-element-prev:            "";
    terminal:                   "footclient";
    run-command:                "rofi-run {cmd}";
    run-shell-command:          "rofi-run -t {cmd}";
    drun {
        gio-launch:             false;
    }
}

@import "../theme.rasi"

window {
    width:                       1000px;
    border:                      1px;
    border-color:                @border-color;
    border-radius:               8px;
}

mainbox {
    spacing:                     24px;
    padding:                     32px;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    spacing:                     0px;
    padding:                     0px 0px 0px 10px;
    background-color:            @background-alt;
    border-radius:               8px;
    children:                    [ "entry", "mode-switcher" ];
}

prompt {
    enabled:                     false;
}

entry {
    expand:                      true;
    background-color:            @background-alt;
    text-color:                  @foreground;
    placeholder:                 "Tab to switch mode";
    placeholder-color:           @foreground;
    padding:                     16px;
    vertical-align:              0.5;
    cursor:                      text;
}

mode-switcher {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
}

button {
    width:                       84px;
    padding:                     0px;
    border-radius:               0px;
    background-color:            @background-surface;
    text-color:                  @foreground;
    cursor:                      pointer;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

button selected {
    background-color:            @selected;
    text-color:                  @selected-fg;
    border-color:                @selected;
}

listview {
    columns:                     7;
    lines:                       3;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     4px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      default;
}

element {
    orientation:                 vertical;
    spacing:                     10px;
    padding:                     10px;
    border-radius:               8px;
    border:                      1px;
    border-color:                transparent;
    background-color:            @background;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-fg;
    border-color:                @selected;
}

element selected.active {
    background-color:            @selected;
    text-color:                  @selected-fg;
    border-color:                @selected;
}

element selected.urgent {
    background-color:            @urgent;
    text-color:                  @selected-fg;
    border-color:                @urgent;
}

element-icon {
    size:                        64px;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    background-color:            transparent;
    cursor:                      inherit;
}

element-text {
    horizontal-align:            0.5;
    vertical-align:              0.5;
    font:                        "Maple Mono NF 11";
    text-color:                  inherit;
    cursor:                      inherit;
}
