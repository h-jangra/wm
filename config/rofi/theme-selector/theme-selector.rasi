@import "../theme.rasi"

configuration {
    show-icons: false;
}

window {
    width:                       760px;
    location:                    center;
    anchor:                      center;
}

mainbox {
    spacing:                     12px;
    border-color:                @border-colour;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    padding:                     10px 14px;
}

entry {
    placeholder:                 "Select desktop theme...";
}

listview {
    lines:                       3;
    columns:                     3;
    cycle:                       true;
    scrollbar:                   false;
    spacing:                     8px;
    flow:                        horizontal;
}

element {
    orientation:                 horizontal;
    padding:                     14px 16px;
    border-radius:               8px;
    cursor:                      pointer;
    background-color:            transparent;
}

element-icon {
    enabled:                     false;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    cursor:                      inherit;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-fg;
    border:                      1px;
    border-color:                @selected;
    font-weight:                 bold;
}
