/**
 * Rofi Wallpaper Selector Theme - 3-Column Grid with Thumbnails
 **/
@import "theme.rasi"

window {
    width:                       760px;
    location:                    center;
    anchor:                      center;
}

listview {
    lines:                       3;
    columns:                     3;
    spacing:                     8px;
    flow:                        horizontal;
}

element {
    orientation:                 vertical;
    padding:                     12px 8px;
    border-radius:               6px;
    spacing:                     8px;
    cursor:                      pointer;
    border:                      0px;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-fg;
    border:                      1px;
    border-color:                @selected;
    font-weight:                 bold;
}

element-icon {
    size:                        56px;
    horizontal-align:            0.5;
    cursor:                      inherit;
}

element-text {
    horizontal-align:            0.5;
    font:                        "Maple Mono NF 12";
    cursor:                      inherit;
}

entry {
    placeholder:                 "Select wallpaper or randomize...";
}
