
@import "colors.rasi"

configuration {
    show-icons: true;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       1000px;
    x-offset:                    0px;
    y-offset:                    0px;
    padding:                     0px;
    border:                      1px;
    border-radius:               8px;
    background-color:            @background;
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview", "message" ];
}

inputbar {
    enabled:                     true;
    spacing:                     8px;
    padding:                     18px 24px;
    background-color:            transparent;
    children:                    [ "prompt", "entry" ];
}

entry {
    enabled:                     true;
    expand:                      true;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      text;
    font:                        "Maple Mono NF 13";
    placeholder:                 "Search";
    placeholder-color:           @foreground;
    padding:                     12px 16px;
    border-radius:               0px 8px 8px 0px;
}

prompt {
    enabled:                     true;
    background-color:            @selected;
    text-color:                  @selected-fg;
    font:                        "Maple Mono NF Bold 13";
    padding:                     12px 16px;
    border-radius:               8px 0px 0px 8px;
}

listview {
    enabled:                     true;               
    columns:                     1;                  
    lines:                       8;                  
    cycle:                       true;               
    dynamic:                     true;               
    scrollbar:                   false;              
    layout:                      vertical;           
    reverse:                     false;              
    fixed-height:                true;               
    fixed-columns:               true;               
    spacing:                     4px;                
    margin:                      12px 16px 16px;
    background-color:            transparent;        
    cursor:                      default;            
}

element {
    enabled:                     true;
    padding:                     12px 16px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element-text {
    font:                        "Maple Mono NF 11";
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element-icon {
    size:                       24px;
    background-color:           transparent;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-fg;
}

element alternate.normal {
    background-color:            transparent;
}

message {
    enabled:                     true;
    margin:                      8px 16px 16px;
    padding:                     12px;
    border-radius:               8px;
    background-color:            @background-alt;
    text-color:                  @foreground;
}

textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
