/**
 * Unified Polished Geometric Theme for Rofi Menus
 * Styled after the Noctalia / Omarchy design language.
 **/
@import "colors.rasi"

* {
    /* Fallback tokens */
    background:                  #1e1e2eF2;
    background-alt:              #181825FF;
    background-surface:          #313244FF;
    border-color:                #45475aFF;
    foreground:                  #cdd6f4FF;
    foreground-muted:            #6c7086FF;
    foreground-bright:           #ffffffFF;
    selected:                    #b4befeFF;
    selected-fg:                 #181825FF;
    accent:                      #b4befeFF;
    urgent:                      #f38ba8FF;
    active:                      #a6e3a1FF;
    warning:                     #f9e2afFF;

    font:                        "Maple Mono NF 13";
    background-color:            transparent;
    text-color:                  @foreground;
}

window {
    transparency:                "real";
    background-color:            @background;
    border:                      1px;
    border-color:                @selected;
    border-radius:               6px;
    padding:                     14px;
}

mainbox {
    spacing:                     10px;
    children:                    [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing:                     10px;
    padding:                     8px 12px;
    background-color:            @background-alt;
    border:                      1px;
    border-color:                @border-color;
    border-radius:               4px;
    children:                    [ "prompt", "entry" ];
}

prompt {
    text-color:                  @selected;
    font-weight:                 bold;
}

entry {
    placeholder:                 "Search...";
    placeholder-color:           @foreground-muted;
    text-color:                  @foreground-bright;
}

listview {
    lines:                       8;
    columns:                     1;
    cycle:                       true;
    scrollbar:                   false;
    spacing:                     4px;
}

element {
    padding:                     8px 12px;
    border-radius:               4px;
    spacing:                     10px;
    border:                      0px;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element normal.urgent {
    background-color:            transparent;
    text-color:                  @urgent;
}

element normal.active {
    background-color:            transparent;
    text-color:                  @active;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-fg;
    border:                      1px;
    border-color:                @selected;
    font-weight:                 bold;
}

element selected.urgent {
    background-color:            @urgent;
    text-color:                  @selected-fg;
}

element selected.active {
    background-color:            @selected;
    text-color:                  @selected-fg;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element alternate.urgent {
    background-color:            transparent;
    text-color:                  @urgent;
}

element alternate.active {
    background-color:            transparent;
    text-color:                  @active;
}

element-icon {
    size:                        22px;
    cursor:                      inherit;
}

element-text {
    cursor:                      inherit;
    vertical-align:              0.5;
    text-color:                  inherit;
}

message {
    padding:                     8px 12px;
    background-color:            @background-alt;
    border:                      1px;
    border-color:                @border-color;
    border-radius:               4px;
}

textbox {
    text-color:                  @accent;
    vertical-align:              0.5;
}
