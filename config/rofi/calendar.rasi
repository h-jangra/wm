/**
 * Rofi Calendar Theme - Enlarged & Minimal Layout
 **/

@import "theme.rasi"

window {
    width:                       580px;
    location:                    center;
    anchor:                      center;
    border-radius:               8px;
}

mainbox {
    spacing:                     14px;
    children:                    [ "message", "listview" ];
}

message {
    padding:                     18px 24px;
    background-color:            @background-alt;
    border:                      1px;
    border-color:                @border-color;
    border-radius:               6px;
}

textbox {
    text-color:                  @foreground;
    font:                        "Maple Mono NF 15";
    horizontal-align:            0.5;
    vertical-align:              0.5;
}

listview {
    lines:                       2;
    columns:                     2;
    flow:                        horizontal;
    spacing:                     10px;
    cycle:                       true;
    scrollbar:                   false;
}

element {
    padding:                     10px 14px;
    border-radius:               6px;
}

element-text {
    horizontal-align:            0.5;
    vertical-align:              0.5;
    font:                        "Maple Mono NF 14";
}
