/**
 * Rofi Theme Selector - Polished 3x3 Grid Layout
 **/
@import "theme.rasi"

window {
    width:                       660px;
    location:                    center;
    anchor:                      center;
}

mainbox {
    spacing:                     12px;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    padding:                     10px 14px;
}

entry {
    placeholder:                 "Select desktop theme...";
}

listview {
    lines:                       3;
    columns:                     3;
    cycle:                       true;
    scrollbar:                   false;
    spacing:                     8px;
    flow:                        horizontal;
}

element {
    orientation:                 vertical;
    padding:                     16px 12px;
    border-radius:               6px;
    spacing:                     8px;
    cursor:                      pointer;
    border:                      0px;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-fg;
    border:                      1px;
    border-color:                @selected;
    font-weight:                 bold;
}

element-icon {
    size:                        36px;
    horizontal-align:            0.5;
    cursor:                      inherit;
}

element-text {
    horizontal-align:            0.5;
    font:                        "Maple Mono NF Medium 13";
    cursor:                      inherit;
}
