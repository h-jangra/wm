#!/usr/bin/env bash
# launch-btop: Toggle btop system monitor and ensure instant keyboard focus
set -euo pipefail

# If btop is already running, toggle it closed
if pgrep -x btop >/dev/null 2>&1; then
    pkill -x btop 2>/dev/null || true
    exit 0
fi

# Launch btop in floating foot window with dedicated app-id
if command -v foot >/dev/null 2>&1; then
    foot --app-id=btop -w 820x720 -T "btop" -e btop &
elif command -v footclient >/dev/null 2>&1; then
    footclient -a btop -w 820x720 -T "btop" -e btop &
else
    btop &
fi

# Ensure the newly created btop window gets immediate keyboard focus
# so Super+q kills it on the very first press
sleep 0.12
if command -v mmsg >/dev/null 2>&1; then
    bid=$(mmsg get clients 2>/dev/null | jq -r '.[] | select(.appid=="btop" or .title=="btop") | .id' 2>/dev/null | tail -n 1 || true)
    if [[ -n "$bid" && "$bid" != "null" ]]; then
        mmsg dispatch focusclient "$bid" >/dev/null 2>&1 || true
    fi
fi
