#!/usr/bin/env bash
set -uo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rofi"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
ROFI_DIR="$REPO_DIR/components/rofi"

RASI=""
for file in "$ROFI_DIR/powermenu/power-profile.rasi" "$CONF_DIR/powermenu/power-profile.rasi" "$CONF_DIR/power-profile.rasi" "$SCRIPT_DIR/power-profile.rasi"; do
    if [[ -f "$file" ]]; then
        RASI="$file"
        break
    fi
done

CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/wm-power-profile"

ROFI_ARGS=(-dmenu -i -p "Power Profile")
[[ -n "$RASI" ]] && ROFI_ARGS+=(-theme "$RASI")

notify() {
    notify-send -h string:x-canonical-private-synchronous:wm-power \
        "Power Profile" "$1"
}

get_profile() {
    if command -v powerprofilesctl >/dev/null 2>&1; then
        case "$(powerprofilesctl get 2>/dev/null)" in
            power-saver) echo "powersave" ;;
            performance) echo "performance" ;;
            balanced) echo "balanced" ;;
            *) echo "balanced" ;;
        esac
    elif [[ -r /sys/firmware/acpi/platform_profile ]]; then
        case "$(cat /sys/firmware/acpi/platform_profile)" in
            low-power) echo "powersave" ;;
            performance) echo "performance" ;;
            balanced) echo "balanced" ;;
            *) echo "balanced" ;;
        esac
    else
        cat "$CACHE_FILE" 2>/dev/null || echo "balanced"
    fi
}

current=$(get_profile)

power_save="󰌪  Power Save"
balanced="󰾆  Balanced"
performance="󰓅  Performance"

case "$current" in
    powersave) power_save+="  ✓" ;;
    performance) performance+="  ✓" ;;
    *) balanced+="  ✓" ;;
esac

options="$power_save"$'\n'"$balanced"$'\n'"$performance"

chosen=$(printf '%s\n' "$options" | rofi "${ROFI_ARGS[@]}")

[[ -z "$chosen" ]] && exit 0

case "$chosen" in
    *"Power Save"*) target="powersave"; label="Power Save" ;;
    *"Balanced"*) target="balanced"; label="Balanced" ;;
    *"Performance"*) target="performance"; label="Performance" ;;
    *) exit 0 ;;
esac

if command -v powerprofilesctl >/dev/null 2>&1; then
    profile="$target"
    [[ "$profile" == "powersave" ]] && profile="power-saver"

    if ! powerprofilesctl set "$profile" 2>/dev/null; then
        notify "Failed to activate $label"
        exit 1
    fi
else
    sysfs="/sys/firmware/acpi/platform_profile"
    choices_file="/sys/firmware/acpi/platform_profile_choices"
    available=""
    [[ -r "$choices_file" ]] && available="$(cat "$choices_file")"

    if [[ "$target" == "powersave" ]]; then
        if [[ "$available" =~ "quiet" ]]; then
            profile="quiet"
        elif [[ "$available" =~ "low-power" ]]; then
            profile="low-power"
        elif [[ "$available" =~ "cool" ]]; then
            profile="cool"
        elif [[ "$available" =~ "powersave" ]]; then
            profile="powersave"
        else
            profile="low-power"
        fi
    elif [[ "$target" == "performance" ]]; then
        profile="performance"
    else
        profile="balanced"
    fi

    if [[ -w "$sysfs" ]]; then
        if ! printf '%s' "$profile" > "$sysfs"; then
            notify "Failed to activate $label"
            exit 1
        fi
    elif command -v pkexec >/dev/null 2>&1; then
        if ! pkexec sh -c 'printf "%s" "$1" > /sys/firmware/acpi/platform_profile' \
            sh "$profile"; then
            notify "Failed to activate $label"
            exit 1
        fi
    else
        notify "No supported power-management method"
        exit 1
    fi
fi

mkdir -p "$(dirname "$CACHE_FILE")"
printf '%s\n' "$target" > "$CACHE_FILE"

notify "Mode activated: $label"
