/**
 * Rofi Theme Selector - Polished 3x3 Grid Layout
 **/
@import "../theme.rasi"

window {
    width:                       760px;
    location:                    center;
    anchor:                      center;
}

mainbox {
    spacing:                     12px;
    border-color:                @border-colour;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    padding:                     10px 14px;
}

entry {
    placeholder:                 "Select desktop theme...";
}

listview {
    lines:                       3;
    columns:                     3;
    cycle:                       true;
    scrollbar:                   false;
    spacing:                     8px;
    flow:                        horizontal;
}

element {
    orientation: vertical;
    border-radius: 6px;
    cursor: pointer;
}

element-text {
    background-color: transparent;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-fg;
    border:                      1px;
    border-color:                @selected;
    font-weight:                 bold;
}

