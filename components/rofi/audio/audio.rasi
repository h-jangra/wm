/**
 * Rofi Audio Sink & Source Theme - 2-Column Grid Layout
 **/

@import "theme.rasi"

window {
    width:                       680px;
    location:                    center;
    anchor:                      center;
}

mainbox {
    spacing:                     12px;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    padding:                     10px 14px;
}

listview {
    lines:                       6;
    columns:                     2;
    flow:                        horizontal;
    spacing:                     8px;
    cycle:                       true;
    scrollbar:                   false;
    dynamic:                     true;
    fixed-height:                false;
}

element {
    padding:                     9px 12px;
    border-radius:               4px;
}

element-text {
    vertical-align:              0.5;
}
