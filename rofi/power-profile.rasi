/**
 * Rofi Power Profile Theme - 3-Column Grid Layout
 **/

@import "theme.rasi"

window {
    width:                       660px;
    location:                    center;
    anchor:                      center;
    border-radius:               8px;
}

mainbox {
    spacing:                     12px;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    padding:                     10px 14px;
}

listview {
    lines:                       1;
    columns:                     3;
    spacing:                     10px;
    cycle:                       true;
    scrollbar:                   false;
}

element {
    padding:                     12px 8px;
    border-radius:               6px;
}

element-text {
    horizontal-align:            0.5;
    vertical-align:              0.5;
    font:                        "Maple Mono NF 12.5";
}
