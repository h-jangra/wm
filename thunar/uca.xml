<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1700000000000001-1</unique-id>
	<command>foot -D %f</command>
	<description>Open Foot terminal in current directory</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>edit-copy</icon>
	<name>Copy Absolute Path</name>
	<submenu></submenu>
	<unique-id>1700000000000002-2</unique-id>
	<command>printf '%s' %f | wl-copy -n &amp;&amp; notify-send -h string:x-canonical-private-synchronous:wm-clip "Path Copied" "%f"</command>
	<description>Copy full file path to clipboard</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>edit-copy</icon>
	<name>Copy Filename</name>
	<submenu></submenu>
	<unique-id>1700000000000003-3</unique-id>
	<command>printf '%s' %n | wl-copy -n &amp;&amp; notify-send -h string:x-canonical-private-synchronous:wm-clip "Filename Copied" "%n"</command>
	<description>Copy filename to clipboard</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Set as Wallpaper</name>
	<submenu></submenu>
	<unique-id>1700000000000004-4</unique-id>
	<command>wallpaper-switch %f</command>
	<description>Set selected image as active wallpaper</description>
	<range></range>
	<patterns>*.jpg;*.jpeg;*.png;*.webp;*.gif;*.bmp</patterns>
	<image-files/>
</action>
<action>
	<icon>package-x-generic</icon>
	<name>Compress to Archive</name>
	<submenu></submenu>
	<unique-id>1700000000000005-5</unique-id>
	<command>tar -czvf "%f.tar.gz" -C "$(dirname "%f")" "$(basename "%f")" &amp;&amp; notify-send "Archive Created" "%f.tar.gz"</command>
	<description>Compress selected item into a .tar.gz archive</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>archive-extract</icon>
	<name>Extract Archive Here</name>
	<submenu></submenu>
	<unique-id>1700000000000006-6</unique-id>
	<command>sh -c 'dir="$(dirname "%f")"; case "%f" in *.tar.gz|*.tgz) tar -xzf "%f" -C "$dir" ;; *.tar.bz2|*.tbz2) tar -xjf "%f" -C "$dir" ;; *.tar.xz|*.txz) tar -xJf "%f" -C "$dir" ;; *.zip) unzip -o "%f" -d "$dir" ;; *.tar) tar -xf "%f" -C "$dir" ;; esac &amp;&amp; notify-send "Archive Extracted" "$(basename "%f")"'</command>
	<description>Extract archive contents into the current folder</description>
	<range></range>
	<patterns>*.tar;*.tar.gz;*.tgz;*.tar.bz2;*.tbz2;*.tar.xz;*.txz;*.zip</patterns>
	<other-files/>
</action>
<action>
	<icon>text-editor</icon>
	<name>Edit in Terminal</name>
	<submenu></submenu>
	<unique-id>1700000000000007-7</unique-id>
	<command>foot -e nvim %f</command>
	<description>Open selected file with Neovim in Foot terminal</description>
	<range></range>
	<patterns>*</patterns>
	<text-files/>
	<other-files/>
</action>
</actions>
