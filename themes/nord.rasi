/**
 * Nord Color Palette - Rofi Variables
 **/

* {
    /* Polar Night */
    background:                  #2E3440FF;
    background-alt:              #3B4252FF;
    background-surface:          #434C5EFF;
    border-color:                #4C566AFF;

    /* Snow Storm */
    foreground:                  #D8DEE9FF;
    foreground-muted:            #4C566AFF;
    foreground-bright:           #ECEFF4FF;

    /* Frost */
    selected:                    #88C0D0FF;
    selected-fg:                 #2E3440FF;
    accent:                      #81A1C1FF;
    teal:                        #8FBCBBFF;

    /* Aurora */
    urgent:                      #BF616AFF;
    active:                      #A3BE8CFF;
    warning:                     #EBCB8BFF;
}
