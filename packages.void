# ==============================================================================
# Void Linux Package List for Custom MangoWC Rice
# Install via: sudo xbps-install -Sy $(grep -vE '^\s*#|^\s*$' packages.void)
# ==============================================================================

# Core Wayland Compositor & Desktop Shell
mangowc
foot
alacritty
rofi
swaybg
swaylock
hyprpicker
mako
libnotify
Thunar
thunar-archive-plugin
thunar-volman
papirus-icon-theme
tumbler

# Status Bar & Widgets (MangoBar built from source or package, Eww optional)
mangobar

# Audio Subsystem (PipeWire + WirePlumber)
pipewire
wireplumber
alsa-pipewire
libspa-bluetooth

# Networking & Bluetooth
NetworkManager
bluez

# Hardware, Seat & Authentication
dbus
brightnessctl
elogind
polkit
polkit-gnome

# Screen Capture & Clipboard Management
grim
slurp
wl-clipboard
cliphist
tesseract-ocr
tesseract-ocr-eng

# System Monitoring & Utilities
btop
jq
fzf
fd
ripgrep
xmirror
github-cli
v4l-utils

# Build Tools (for source builds: MangoBar, Ly)
meson
ninja
pkg-config
wayland-devel
wayland-protocols
fcft-devel
pixman-devel
cairo-devel
pango-devel
pulseaudio-devel
eudev-libudev-devel
gdk-pixbuf-devel
cJSON-devel
basu-devel

# Core CLI Utilities
unzip
zip
tar
curl
wget
git
tree
less
pciutils
usbutils
procps-ng
util-linux
lsof
