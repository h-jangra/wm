# ==============================================================================
# Void Linux Package List for Custom MangoWC Rice
# Minimal, essential dependencies without bloat or duplicate daemons.
# Install via: sudo xbps-install -Sy $(grep -vE '^\s*#|^\s*$' packages.void)
# ==============================================================================

# Core Wayland Compositor & Desktop Shell
mangowc
# xorg-server-xwayland
Waybar
foot
rofi
swaybg
swaylock
mako
libnotify
Thunar
thunar-archive-plugin
thunar-volman
papirus-icon-theme
tumbler

# Audio Subsystem (PipeWire + WirePlumber)
pipewire
wireplumber
alsa-pipewire
libspa-bluetooth

# Networking & Bluetooth
NetworkManager
bluez

# Hardware, Seat & Authentication
dbus
brightnessctl
elogind
polkit
polkit-gnome

# Screen Capture & Clipboard Management
grim
slurp
wl-clipboard
cliphist

# Utilities, Repositories & Fonts
jq
fzf
fd
ripgrep
xmirror

# Basic CLI Utilities
unzip
zip
tar
curl
wget
git
tree
less
pciutils
usbutils
procps-ng
util-linux
